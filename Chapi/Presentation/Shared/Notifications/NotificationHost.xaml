<UserControl x:Class="Chapi.Presentation.Shared.Notifications.NotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <Border MaxWidth="420"
            MaxHeight="220"
            Padding="12"
            Background="{Binding CurrentBackgroundBrush}"
            BorderBrush="{Binding CurrentBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Effect="{DynamicResource MaterialDesignElevationShadow4}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border Width="42"
                    Height="42"
                    VerticalAlignment="Top"
                    Background="#19FFFFFF"
                    CornerRadius="21">
                <materialDesign:PackIcon Width="22"
                                         Height="22"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{Binding CurrentForegroundBrush}"
                                         Kind="{Binding CurrentIconKind}" />
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="10,0,0,0">
                <TextBlock FontSize="15"
                           FontWeight="Bold"
                           Foreground="{Binding CurrentForegroundBrush}"
                           Text="{Binding CurrentTitle}" />
                <ScrollViewer Margin="0,6,0,0"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <TextBlock Foreground="{Binding CurrentForegroundBrush}"
                               Opacity="0.92"
                               Text="{Binding CurrentMessage}"
                               TextWrapping="Wrap" />
                </ScrollViewer>
            </StackPanel>

            <Button Grid.Column="2"
                    Width="28"
                    Height="28"
                    Margin="12,-4,-4,0"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Command="{Binding CloseCommand}"
                    Foreground="{Binding CurrentForegroundBrush}"
                    Opacity="0.68"
                    ToolTip="Cerrar">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Opacity" Value="0.68" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="1" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <materialDesign:PackIcon Kind="Close"
                                         Width="14"
                                         Height="14" />
            </Button>
        </Grid>
    </Border>
</UserControl>
