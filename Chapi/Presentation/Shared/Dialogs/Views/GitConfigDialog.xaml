<UserControl x:Class="Chapi.Presentation.Shared.Dialogs.Views.GitConfigDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             x:Name="Self"
             Width="650"
             Height="500">
    <Border BorderThickness="1"
            Padding="0"
            CornerRadius="8"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            Background="{DynamicResource MaterialDesignPaper}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Titulo -->
            <Border Grid.Row="0" 
                    Background="{DynamicResource PrimaryHueMidBrush}"
                    CornerRadius="8,8,0,0"
                    Padding="24,20">
                <TextBlock Text="Configuracion"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{DynamicResource ActionTextOnAccentBrush}"/>
            </Border>

            <!-- TabControl -->
            <TabControl Grid.Row="1" 
                        Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                        Margin="0"
                        materialDesign:NavigationRailAssist.ShowSelectionBackground="True">
                <TabControl.Resources>
                    <Style TargetType="TabItem" BasedOn="{StaticResource MaterialDesignNavigationRailTabItem}">
                        <Setter Property="MinWidth" Value="140"/>
                        <Setter Property="Padding" Value="16,12"/>
                    </Style>
                </TabControl.Resources>
                
                <!-- Pestana: Accounts -->
                <TabItem Width="110">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Account" Width="22" Height="22" Margin="0,0,12,0"/>
                            <TextBlock Text="Accounts" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>
                    
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
                        <StackPanel MaxWidth="500">
                            <!-- Cuenta autenticada -->
                            <TextBlock Text="Cuentas conectadas" 
                                      FontSize="18" 
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,20"/>

                            <!-- GitHub/GitLab Account Card -->
                            <Border x:Name="AccountCard"
                                    Background="{DynamicResource MaterialDesignCardBackground}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20"
                                    Margin="0,0,0,20">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Fila 1: Avatar + Info -->
                                    <Grid Grid.Row="0" Margin="0,0,0,16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Avatar -->
                                        <Border Grid.Column="0"
                                                Width="64"
                                                Height="64"
                                                CornerRadius="32"
                                                Margin="0,0,20,0"
                                                BorderBrush="{DynamicResource PrimaryHueMidBrush}"
                                                BorderThickness="2">
                                            <Border.Clip>
                                                <EllipseGeometry Center="32,32" RadiusX="32" RadiusY="32"/>
                                            </Border.Clip>
                                            <Image x:Name="AccountAvatar" Stretch="UniformToFill"/>
                                        </Border>

                                        <!-- Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock x:Name="AccountName" 
                                                      FontSize="18" 
                                                      FontWeight="SemiBold"
                                                      Margin="0,0,0,4"/>
                                            <TextBlock x:Name="AccountUsername" 
                                                      FontSize="14" 
                                                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                      Margin="0,0,0,6"/>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon x:Name="ProviderIcon" 
                                                                        Width="16" 
                                                                        Height="16" 
                                                                        Margin="0,0,6,0"
                                                                        VerticalAlignment="Center"/>
                                                <TextBlock x:Name="ProviderName" 
                                                          FontSize="13" 
                                                          Foreground="{DynamicResource MaterialDesignBodyLight}"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Fila 2: Sign out button -->
                                    <Button Grid.Row="1"
                                            Content="Sign out"
                                            Click="SignOutButton_Click"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            HorizontalAlignment="Stretch"
                                            Height="40"/>
                                </Grid>
                            </Border>

                            <!-- Info -->
                            <TextBlock TextWrapping="Wrap"
                                      FontSize="13"
                                      Foreground="{DynamicResource MaterialDesignBodyLight}"
                                      LineHeight="20">
                                <Run Text="Esta es tu cuenta autenticada para push/pull. Al cerrar sesion, necesitaras volver a autenticarte para realizar operaciones remotas."/>
                            </TextBlock>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- Pestana: Git -->
                <TabItem Width="110">
                    <TabItem.Header>
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Git" Width="22" Height="22" Margin="0,0,12,0"/>
                            <TextBlock Text="Git" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </TabItem.Header>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="32,24">
                        <StackPanel MaxWidth="500">
                            <TextBlock Text="Configuracion local de Git" 
                                      FontSize="18" 
                                      FontWeight="SemiBold"
                                      Margin="0,0,0,20"/>

                            <!-- Name -->
                            <TextBox x:Name="NameTextBox"
                                    materialDesign:HintAssist.Hint="Name"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Margin="0,0,0,20"
                                    FontSize="14"
                                    Height="56"/>

                            <!-- Email -->
                            <TextBox x:Name="EmailTextBox"
                                    materialDesign:HintAssist.Hint="Email"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Margin="0,0,0,20"
                                    FontSize="14"
                                    Height="56"/>

                            <!-- Default branch name -->
                            <TextBox x:Name="DefaultBranchTextBox"
                                    materialDesign:HintAssist.Hint="Default branch name for new repositories"
                                    Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                    Margin="0,0,0,24"
                                    FontSize="14"
                                    Height="56"/>

                            <!-- Nota informativa -->
                            <Border Background="#FFF3E0" 
                                    BorderBrush="#FFB74D" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Padding="16">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <materialDesign:PackIcon Kind="InformationOutline" 
                                                                Foreground="#F57C00" 
                                                                Width="18" 
                                                                Height="18" 
                                                                VerticalAlignment="Top"
                                                                Margin="0,2,10,0"/>
                                        <TextBlock Text="Configuracion local de Git" 
                                                  FontWeight="SemiBold" 
                                                  FontSize="13"
                                                  Foreground="#E65100"/>
                                    </StackPanel>
                                    
                                    <TextBlock TextWrapping="Wrap"
                                              FontSize="12"
                                              Foreground="#5D4037"
                                              Margin="28,0,0,0"
                                              LineHeight="18">
                                        <Run Text="Esta configuracion es solo para tu maquina local y NO afecta tu cuenta de GitHub/GitLab."/>
                                        <LineBreak/>
                                        <LineBreak/>
                                        <Run Text="Recomendacion: " FontWeight="SemiBold"/>
                                        <Run Text="Usa el mismo email que tienes verificado en GitHub/GitLab para que tus commits se enlacen automaticamente a tu perfil."/>
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- Botones -->
            <Border Grid.Row="2" 
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,1,0,0"
                    Padding="24,20"
                    Background="{DynamicResource MaterialDesignCardBackground}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCELAR"
                            Click="CancelButton_Click"
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Margin="0,0,12,0"
                            Height="40"
                            Padding="20,0"/>
                    <Button Content="GUARDAR"
                            Click="SaveButton_Click"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Height="40"
                            Padding="24,0"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>

