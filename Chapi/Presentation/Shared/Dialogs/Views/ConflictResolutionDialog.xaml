<UserControl x:Class="Chapi.Presentation.Shared.Dialogs.Views.ConflictResolutionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Chapi.Presentation.Shared.Dialogs.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="900"
             Background="{DynamicResource MaterialDesignPaper}"
             Foreground="{DynamicResource MaterialDesignBody}"
             MinHeight="500" MinWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Resolución de Conflictos" Style="{StaticResource MaterialDesignHeadline5TextBlock}" FontWeight="Bold" Margin="0,0,0,10"/>
        
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
            <materialDesign:PackIcon Kind="FileAlertOutline" Width="24" Height="24" Foreground="{DynamicResource StatusWarningBrush}" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding SelectedConflict.FilePath}" Style="{StaticResource MaterialDesignSubtitle1TextBlock}" VerticalAlignment="Center" FontWeight="SemiBold"/>
            
            <TextBlock Text="{Binding ProgressText}" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MaterialDesignSecondaryText}"/>
        </StackPanel>

        <!-- Conflict Editor Area -->
        <Grid Grid.Row="2" IsEnabled="{Binding SelectedConflict.IsResolved, Converter={StaticResource InverseBoolConverter}, FallbackValue=True}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Local Changes (Current) -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource StatusSuccessBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <Border Background="{DynamicResource StatusSuccessMutedBackgroundBrush}" Padding="10" CornerRadius="4,4,0,0">
                        <TextBlock Text="Cambio Local (Current Change)" FontWeight="Bold" Foreground="{DynamicResource StatusSuccessBrush}"/>
                    </Border>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding CurrentBlock.LocalContent}" FontFamily="Consolas" Padding="10" 
                                   Background="{DynamicResource StatusSuccessMutedBackgroundBrush}" TextWrapping="NoWrap"/>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Aceptar Cambio Local" Margin="10" 
                            Command="{Binding AcceptLocalCommand}"
                            Style="{StaticResource MaterialDesignFlatLightBgButton}" Background="{DynamicResource StatusSuccessMutedBackgroundBrush}" Foreground="{DynamicResource StatusSuccessBrush}"/>
                </Grid>
            </Border>

            <!-- Divider -->
            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

            <!-- Incoming Changes -->
            <Border Grid.Column="2" BorderBrush="{DynamicResource StatusInfoBrush}" BorderThickness="1" CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource StatusInfoMutedBackgroundBrush}" Padding="10" CornerRadius="4,4,0,0">
                        <TextBlock Text="Cambio Entrante (Incoming Change)" FontWeight="Bold" Foreground="{DynamicResource StatusInfoBrush}"/>
                    </Border>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding CurrentBlock.IncomingContent}" FontFamily="Consolas" Padding="10" 
                                   Background="{DynamicResource StatusInfoMutedBackgroundBrush}" TextWrapping="NoWrap"/>
                    </ScrollViewer>

                    <Button Grid.Row="2" Content="Aceptar Cambio Entrante" Margin="10" 
                            Command="{Binding AcceptIncomingCommand}"
                            Style="{StaticResource MaterialDesignFlatLightBgButton}" Background="{DynamicResource StatusInfoMutedBackgroundBrush}" Foreground="{DynamicResource StatusInfoBrush}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Actions -->
        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="Abrir en Editor Externo" Command="{Binding OpenInEditorCommand}" 
                    Style="{StaticResource MaterialDesignOutlinedButton}" ToolTip="Abre el archivo crudo en VS Code (si está instalado) o Notepad"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cerrar / Cancelar Merge" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" 
                        Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,10,0"/>
                
                <Button Content="Marcar como Resuelto" Command="{Binding MarkResolvedCommand}" 
                        Visibility="{Binding SelectedConflict.IsResolved, Converter={StaticResource BooleanToVisibilityConverter}}"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
