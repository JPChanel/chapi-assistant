<UserControl x:Class="Chapi.Presentation.Shared.Dialogs.Views.ConflictResolutionDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:Chapi.Presentation.Converters"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d"
             d:DesignHeight="680"
             d:DesignWidth="980"
             Background="{DynamicResource MaterialDesignPaper}"
             Foreground="{DynamicResource MaterialDesignBody}"
             MinHeight="560"
             MinWidth="860">
    <UserControl.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Resolucion de Conflictos"
                   Style="{StaticResource MaterialDesignHeadline5TextBlock}"
                   FontWeight="Bold"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Kind="FileAlertOutline"
                                         Width="24"
                                         Height="24"
                                         Foreground="{DynamicResource StatusWarningBrush}"
                                         Margin="0,0,10,0"/>
                <TextBlock Text="{Binding SelectedConflict.FilePath}"
                           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <TextBlock Text="{Binding ProgressText}"
                           Margin="20,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource MaterialDesignSecondaryText}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="34,4,0,0">
                <TextBlock Text="{Binding SelectedFileProgressText}"
                           FontWeight="SemiBold"/>
                <TextBlock Text="  |  "
                           Foreground="{DynamicResource MaterialDesignSecondaryText}"/>
                <TextBlock Text="{Binding FileProgressText}"
                           Foreground="{DynamicResource MaterialDesignSecondaryText}"/>
            </StackPanel>

            <TextBlock Text="{Binding ConflictKindText}"
                       Margin="34,6,0,0"
                       Foreground="{DynamicResource MaterialDesignSecondaryText}"
                       TextWrapping="Wrap"/>
            <TextBlock Text="{Binding ConflictLineText}"
                       Margin="34,4,0,0"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource StatusWarningBrush}"
                       TextWrapping="Wrap"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderBrush="{DynamicResource MaterialDesignSecondaryText}"
                    BorderThickness="1"
                    CornerRadius="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Background="{DynamicResource MaterialDesignPaper}"
                            Padding="10"
                            CornerRadius="4,4,0,0">
                        <StackPanel>
                            <TextBlock Text="Archivos en Conflicto"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Los resueltos quedan marcados en verde. Los pendientes siguen en rojo."
                                       Margin="0,4,0,0"
                                       Foreground="{DynamicResource MaterialDesignSecondaryText}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Conflicts}"
                             SelectedItem="{Binding SelectedConflict}"
                             BorderThickness="0"
                             Background="Transparent">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Grid>
                                            <materialDesign:PackIcon x:Name="PendingIcon"
                                                                     Kind="CloseCircle"
                                                                     Width="20"
                                                                     Height="20"
                                                                     Foreground="{DynamicResource MaterialDesignValidationErrorColor}"/>
                                            <materialDesign:PackIcon x:Name="SavedIcon"
                                                                     Kind="CheckCircle"
                                                                     Width="20"
                                                                     Height="20"
                                                                     Foreground="{DynamicResource StatusSuccessBrush}"
                                                                     Visibility="Collapsed"/>
                                        </Grid>

                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <TextBlock Text="{Binding FilePath}"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource MaterialDesignSecondaryText}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                        <Setter TargetName="PendingIcon" Property="Visibility" Value="Collapsed"/>
                                        <Setter TargetName="SavedIcon" Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*"/>
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" IsEnabled="{Binding IsSelectedConflictEditable}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            BorderBrush="{DynamicResource StatusSuccessBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource StatusSuccessMutedBackgroundBrush}"
                                    Padding="10"
                                    CornerRadius="4,4,0,0">
                                <TextBlock Text="{Binding LocalBlockHeader}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource StatusSuccessBrush}"/>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding DisplayLocalContent}"
                                           FontFamily="Consolas"
                                           Padding="10"
                                           Background="{DynamicResource StatusSuccessMutedBackgroundBrush}"
                                           TextWrapping="NoWrap"/>
                            </ScrollViewer>

                            <Button Grid.Row="2"
                                    Content="Aceptar lado local"
                                    Margin="10"
                                    Command="{Binding AcceptLocalCommand}"
                                    Style="{StaticResource MaterialDesignFlatLightBgButton}"
                                    Background="{DynamicResource StatusSuccessMutedBackgroundBrush}"
                                    Foreground="{DynamicResource StatusSuccessBrush}"/>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1"
                                  Width="4"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"/>

                    <Border Grid.Column="2"
                            BorderBrush="{DynamicResource StatusInfoBrush}"
                            BorderThickness="1"
                            CornerRadius="4">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Background="{DynamicResource StatusInfoMutedBackgroundBrush}"
                                    Padding="10"
                                    CornerRadius="4,4,0,0">
                                <TextBlock Text="{Binding IncomingBlockHeader}"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource StatusInfoBrush}"/>
                            </Border>

                            <ScrollViewer Grid.Row="1"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Auto">
                                <TextBlock Text="{Binding DisplayIncomingContent}"
                                           FontFamily="Consolas"
                                           Padding="10"
                                           Background="{DynamicResource StatusInfoMutedBackgroundBrush}"
                                           TextWrapping="NoWrap"/>
                            </ScrollViewer>

                            <Button Grid.Row="2"
                                    Content="Aceptar lado entrante"
                                    Margin="10"
                                    Command="{Binding AcceptIncomingCommand}"
                                    Style="{StaticResource MaterialDesignFlatLightBgButton}"
                                    Background="{DynamicResource StatusInfoMutedBackgroundBrush}"
                                    Foreground="{DynamicResource StatusInfoBrush}"/>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="2"
                        BorderBrush="{DynamicResource MaterialDesignSecondaryText}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Background="{DynamicResource MaterialDesignPaper}"
                                Padding="10"
                                CornerRadius="4,4,0,0">
                            <StackPanel>
                                <TextBlock Text="Resultado Final del Bloque"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Usa Aceptar lado local/entrante para copiar ese contenido aqui. El archivo solo se guarda cuando pulses Guardar archivo resuelto."
                                           Margin="0,4,0,0"
                                           Foreground="{DynamicResource MaterialDesignSecondaryText}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <TextBox Grid.Row="1"
                                 Text="{Binding ResolvedContent, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 AcceptsTab="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 Padding="10"
                                 TextWrapping="NoWrap"
                                 IsReadOnly="{Binding IsSelectedConflictEditable, Converter={StaticResource InverseBooleanConverter}}"/>

                        <StackPanel Grid.Row="2"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    Margin="10">
                            <Button Content="Combinar ambos"
                                    Margin="0,0,10,0"
                                    Command="{Binding AcceptBothCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
                            <Button Content="Guardar archivo resuelto"
                                    Command="{Binding MarkResolvedCommand}"
                                    IsEnabled="{Binding CanSaveCurrentConflict}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0"
                        Orientation="Horizontal">
                <Button Content="Abrir en Editor Externo"
                        Command="{Binding OpenInEditorCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        ToolTip="Abre el archivo en VS Code si esta disponible o en Notepad."/>
                <Button Content="Anterior"
                        Margin="10,0,0,0"
                        Command="{Binding PreviousConflictCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
                <Button Content="Siguiente"
                        Margin="10,0,0,0"
                        Command="{Binding NextConflictCommand}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </StackPanel>

            <StackPanel Grid.Column="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Cerrar"
                        Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                        Style="{StaticResource MaterialDesignFlatButton}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
