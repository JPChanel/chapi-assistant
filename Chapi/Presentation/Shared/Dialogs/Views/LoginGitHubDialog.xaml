<UserControl x:Class="Chapi.Presentation.Shared.Dialogs.Views.LoginGitHubDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Chapi.Presentation.Converters"
             mc:Ignorable="d" 
             Width="400" Padding="24">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:NullToVisibilityConverter x:Key="NullToVisibilityConverter" />
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
    </UserControl.Resources>
    
    <StackPanel>
        <materialDesign:PackIcon Kind="Github" Width="64" Height="64" HorizontalAlignment="Center" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
        
        <TextBlock Text="GitHub Login" Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                   HorizontalAlignment="Center" Margin="0,16,0,0" FontWeight="Bold"/>
        
        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" TextAlignment="Center" 
                   Margin="0,16,0,0" FontSize="14" Opacity="0.8"/>

        <!-- Panel de Código -->
        <StackPanel Margin="0,24,0,0" Visibility="{Binding UserCode, Converter={StaticResource NullToVisibilityConverter}}">
             <TextBlock Text="CÓDIGO DE VERIFICACIÓN" Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                        HorizontalAlignment="Center" Opacity="0.6"/>
             <Border Background="{DynamicResource MaterialDesignDivider}" CornerRadius="12" Padding="20" Margin="0,8,0,0">
                 <TextBlock Text="{Binding UserCode}" FontSize="36" FontFamily="Consolas"
                            HorizontalAlignment="Center" FontWeight="Bold"/>
             </Border>
             <TextBlock Text="Copia este código y pégalo en el navegador" 
                        Style="{StaticResource MaterialDesignCaptionTextBlock}" 
                        HorizontalAlignment="Center" Margin="0,8,0,0" Opacity="0.6"/>
        </StackPanel>

        <!-- Indicador de Carga -->
        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                     Value="0" IsIndeterminate="True" Width="30" Height="30"
                     HorizontalAlignment="Center" Margin="0,24,0,0" 
                     Visibility="{Binding IsWaiting, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- Botones -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,32,0,0">
            <Button Command="{Binding CancelCommand}" Content="CANCELAR" 
                    Style="{StaticResource MaterialDesignFlatButton}" Margin="0,0,12,0"/>
            
            <Button Command="{Binding LoginCommand}" Content="CONECTAR" 
                    Style="{StaticResource MaterialDesignRaisedButton}" 
                    Visibility="{Binding IsWaiting, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
        </StackPanel>
    </StackPanel>
</UserControl>
