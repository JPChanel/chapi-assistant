<Window x:Class="Chapi.Presentation.Views.Dialogs.GitProviderSelectionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:converters="clr-namespace:Chapi.Presentation.Converters"
        Title="Conectar con Git"
        Width="500" Height="450"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" Background="#1A132D">
    
    <Window.Resources>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>
    <ScrollViewer  VerticalScrollBarVisibility="Auto" >
        <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0" Padding="24,24,24,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,16" >
                        <md:PackIcon Kind="Github" Width="40" Height="40" Margin="8" Foreground="White"/>
                        <md:PackIcon Kind="Gitlab" Width="40" Height="40" Margin="8" Foreground="#FC6D26"/>
                </StackPanel>
                <TextBlock Text="¡Bienvenido a Chapi!" 
                           Style="{StaticResource MaterialDesignHeadline4TextBlock}"
                           HorizontalAlignment="Center"
                           FontWeight="Bold"
                           Margin="0,0,0,8" Foreground="White"/>
                <TextBlock Text="Para comenzar, conecta tu cuenta de Git"
                           Style="{StaticResource MaterialDesignBody1TextBlock}"
                           HorizontalAlignment="Center"
                           Opacity="0.8" Foreground="White"/>
            </StackPanel>
        </Border>

        <!-- Providers -->
       
         <StackPanel MaxWidth="400" Grid.Row="1">
                
                <!-- GitHub -->
                <md:Card UniformCornerRadius="12" Margin="0,0,0,20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <!-- Banner / Header del Card -->
                        <Border Grid.Row="0"  CornerRadius="12,12,0,0" Padding="20">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Github" Width="32" Height="32" Foreground="White"/>
                                <TextBlock Text="GitHub" Foreground="White" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                                <Border Background="#f1e05a" CornerRadius="4" Margin="10,0,0,0" Padding="8,2" VerticalAlignment="Center">
                                    <TextBlock Text="Recomendado" Foreground="#24292e" FontSize="10" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Body del Card -->
                        <StackPanel Grid.Row="1" Margin="20">
                            <TextBlock Text="Autenticación segura vía navegador. Ideal para repositorios personales y de organización." 
                                       TextWrapping="Wrap" Margin="0,0,0,20" Opacity="0.7" Foreground="White"/>
                            
                            <Button Content="Conectar con GitHub"
                                    Command="{Binding LoginGitHubCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="#2ea44f" BorderBrush="#2ea44f"
                                    Foreground="White"
                                    Height="45"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    md:ButtonAssist.CornerRadius="8"
                                    IsEnabled="{Binding IsAuthenticating, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                    </Grid>
                </md:Card>

                <!-- GitLab -->
                <md:Card UniformCornerRadius="12" Margin="0,0,0,10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Banner / Header del Card -->
                        <Border Grid.Row="0" Background="#FC6D26" CornerRadius="12,12,0,0" Padding="20">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="Gitlab" Width="32" Height="32" Foreground="White"/>
                                <TextBlock Text="GitLab" Foreground="White" FontSize="20" FontWeight="Bold" Margin="12,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Body del Card -->
                        <StackPanel Grid.Row="1" Margin="20">
                            <TextBlock Text="Soporte para GitLab.com y servidores Self-Hosted. Gestión avanzada de CI/CD." 
                                       TextWrapping="Wrap" Margin="0,0,0,20" Opacity="0.7" Foreground="White"/>

                            <Button Content="Conectar con GitLab"
                                    Command="{Binding LoginGitLabCommand}"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    BorderBrush="#FC6D26" Foreground="#FC6D26"
                                    Height="45"
                                    FontSize="16"
                                    FontWeight="Bold"
                                    md:ButtonAssist.CornerRadius="8"
                                    IsEnabled="{Binding IsAuthenticating, Converter={StaticResource InverseBooleanConverter}}"/>
                        </StackPanel>
                    </Grid>
                </md:Card>

            </StackPanel>
       

        <!-- Status & Footer -->
        <Border Grid.Row="2" Padding="24">
            <StackPanel>
                
                <!-- Loading -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                            Margin="0,0,0,0"
                            Visibility="{Binding IsAuthenticating, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 Value="0"
                                 IsIndeterminate="True"
                                 Width="24" Height="24"
                                 Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>

                <!-- Success -->
                <Border Background="#E8F5E9"
                        BorderBrush="#4CAF50"
                        BorderThickness="1"
                        Padding="16"
                        CornerRadius="8"
                        Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <md:PackIcon Kind="CheckCircle" Foreground="#4CAF50" Width="32" Height="32" VerticalAlignment="Center" Margin="0,0,16,0"/>
                        
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="¡Conectado exitosamente!" FontWeight="Bold" Foreground="#1B5E20" FontSize="16"/>
                            <TextBlock Foreground="#2E7D32" Margin="0,4,0,0">
                                <Run Text="Usuario:"/>
                                <Run Text="{Binding AuthenticatedUser}" FontWeight="Bold"/>
                            </TextBlock>
                        </StackPanel>

                        <Button Grid.Column="2"
                                Content="Continuar"
                                Click="CloseButton_Click"
                                Style="{StaticResource MaterialDesignFlatButton}"
                                Foreground="#1B5E20"
                                FontWeight="Bold"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </Grid>
    </ScrollViewer>
</Window>
