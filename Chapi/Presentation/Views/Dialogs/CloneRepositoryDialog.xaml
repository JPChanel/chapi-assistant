<UserControl x:Class="Chapi.Presentation.Views.Dialogs.CloneRepositoryDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:local="clr-namespace:Chapi.Presentation.Views.Dialogs"
             mc:Ignorable="d" 
             d:DesignHeight="620" d:DesignWidth="500"
             Width="500" Height="620"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <Style x:Key="RepositoryGroupItemStyle" TargetType="{x:Type GroupItem}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type GroupItem}">
                        <Expander IsExpanded="True" 
                                  Background="Transparent"
                                  BorderThickness="0,0,0,1"
                                  BorderBrush="{DynamicResource MaterialDesignDivider}">
                            <Expander.Header>
                                <Grid Height="20">
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="ExtraBold"                                                        
                                               Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                               FontSize="17"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Expander.Header>
                            <ItemsPresenter Margin="0,0,0,8" />
                        </Expander>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{DynamicResource PrimaryHueMidBrush}" Height="60">
            <StackPanel Orientation="Horizontal" Margin="24,0">
                <materialDesign:PackIcon Kind="CloudDownloadOutline" Width="28" Height="28" 
                                        VerticalAlignment="Center" Foreground="{DynamicResource ActionTextOnAccentBrush}" />
                <TextBlock Text="Clone New Repository" FontSize="20" FontWeight="SemiBold" 
                           VerticalAlignment="Center" Margin="12,0,0,0" Foreground="{DynamicResource ActionTextOnAccentBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Content Card -->
        <materialDesign:Card Grid.Row="1" Margin="24,20,24,10" materialDesign:ElevationAssist.Elevation="Dp2">
            <Grid>
                <TabControl x:Name="CloneTabs" 
                            Style="{StaticResource MaterialDesignTabControl}"
                            SelectedIndex="{Binding SelectedTabIndex}"
                            materialDesign:ColorZoneAssist.Mode="Standard">
                    
                    <!-- GitHub Tab -->
                    <TabItem Header="GitHub.com">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox materialDesign:HintAssist.Hint="Search projects..."
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:TextFieldAssist.LeadingIcon="Magnify">
                                </TextBox>
                                <Button Grid.Column="1" Margin="8,0,0,0"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding RefreshCommand}"
                                        ToolTip="Refresh list">
                                    <materialDesign:PackIcon Kind="Refresh" />
                                </Button>
                            </Grid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding FilteredView}"
                                     SelectedItem="{Binding SelectedRepo}"
                                     Style="{StaticResource MaterialDesignListBox}">
                                <ListBox.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource RepositoryGroupItemStyle}" />
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="{Binding IsPrivate, Converter={StaticResource BooleanToIconConverter}, ConverterParameter='Lock;BookOutline'}" 
                                                                    Foreground="{DynamicResource PrimaryHueMidBrush}"
                                                                    VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding FullName}" FontSize="14"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" 
                                                          Opacity="0.6" TextTrimming="CharacterEllipsis" 
                                                          Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Login Placeholder for GitHub -->
                            <Grid Grid.Row="1" Visibility="{Binding IsGitHubAuthenticated, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                  Background="{DynamicResource MaterialDesignPaper}" Margin="0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Github" Width="48" Height="48" HorizontalAlignment="Center" Opacity="0.5"/>
                                    <TextBlock Text="Inicia sesión en GitHub para ver tus repositorios" 
                                             Margin="0,16" Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                                    <Button Content="CONECTAR GITHUB" 
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding LoginCommand}"
                                            CommandParameter="GitHub"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- GitLab Tab -->
                    <TabItem Header="GitLab.com">
                        <Grid Margin="16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox materialDesign:HintAssist.Hint="Search projects..."
                                         materialDesign:TextFieldAssist.HasClearButton="True"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         materialDesign:TextFieldAssist.LeadingIcon="Magnify">
                                </TextBox>
                                <Button Grid.Column="1" Margin="8,0,0,0"
                                        Style="{StaticResource MaterialDesignIconButton}"
                                        Command="{Binding RefreshCommand}">
                                    <materialDesign:PackIcon Kind="Refresh" />
                                </Button>
                            </Grid>

                            <ListBox Grid.Row="1" ItemsSource="{Binding FilteredView}"
                                     SelectedItem="{Binding SelectedRepo}"
                                     Style="{StaticResource MaterialDesignListBox}">
                                <ListBox.GroupStyle>
                                    <GroupStyle ContainerStyle="{StaticResource RepositoryGroupItemStyle}" />
                                </ListBox.GroupStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid >
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon Kind="Gitlab" 
                                                                    Foreground="#FC6D26"
                                                                    VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding FullName}" FontSize="14"/>
                                                <TextBlock Text="{Binding Description}" FontSize="11" 
                                                          Opacity="0.6" TextTrimming="CharacterEllipsis"
                                                          Visibility="{Binding Description, Converter={StaticResource NullToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Login Placeholder for GitLab -->
                            <Grid Grid.Row="1" Visibility="{Binding IsGitLabAuthenticated, Converter={StaticResource InverseBooleanToVisibilityConverter}}"
                                  Background="{DynamicResource MaterialDesignPaper}" Margin="0">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <materialDesign:PackIcon Kind="Gitlab" Width="48" Height="48" HorizontalAlignment="Center" Foreground="#FC6D26" Opacity="0.8"/>
                                    <TextBlock Text="Conecta tu cuenta de GitLab para listar tus proyectos" 
                                             Margin="0,16" Opacity="0.7" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="300"/>
                                    <Button Content="CONECTAR GITLAB" 
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Command="{Binding LoginCommand}"
                                            CommandParameter="GitLab"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </TabItem>

                    <!-- URL Tab -->
                    <TabItem Header="URL">
                        <StackPanel Margin="16" VerticalAlignment="Center">
                            <TextBlock Text="Repository URL or GitHub/GitLab link" 
                                     Margin="0,0,0,8" Opacity="0.7" />
                            <TextBox materialDesign:HintAssist.Hint="https://github.com/user/repo.git"
                                     Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Padding="12,12" />
                            <TextBlock Text="Example: https://github.com/abc/sc-assistant.git" 
                                     FontSize="11" Margin="4,8,4,0" Opacity="0.5" FontStyle="Italic" />
                        </StackPanel>
                    </TabItem>
                </TabControl>
                
                <!-- Loading Overlay -->
                <Grid Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                      Background="{DynamicResource MaterialDesignPaper}"
                      Opacity="0.86">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}" 
                                    Value="0" IsIndeterminate="True" 
                                    Width="40" Height="40" Margin="0,0,0,16"/>
                        <TextBlock Text="{Binding LoadingMessage}" FontSize="14" />
                    </StackPanel>
                </Grid>
            </Grid>
        </materialDesign:Card>

        <!-- Footer -->
        <Grid Grid.Row="2" Margin="24,0,24,24">
            <StackPanel>
                <TextBlock Text="Local path" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding LocalPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Padding="12,8" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Choose..." 
                            Style="{StaticResource MaterialDesignOutlinedButton}"
                            Command="{Binding BrowseCommand}"
                            Margin="8,0,0,0" Height="40"/>
                </Grid>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="CANCELAR" 
                            Style="{StaticResource MaterialDesignFlatButton}"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            CommandParameter="{x:Null}"
                            Margin="0,0,8,0" Height="38"/>
                            
                    <Button Content="CLONAR" 
                            Style="{StaticResource MaterialDesignFlatButton}"
                            IsEnabled="{Binding Url, Converter={StaticResource StringToBoolConverter}}"
                            Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}"
                            CommandParameter="{Binding}"
                            Height="38" MinWidth="100" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
