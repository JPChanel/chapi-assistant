<UserControl x:Class="Chapi.Presentation.Views.Dialogs.SquashCommitDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             Background="{DynamicResource MaterialDesignPaper}"
             Width="600">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title -->
            <RowDefinition Height="*"/>    <!-- Content (Message Box) -->
            <RowDefinition Height="Auto"/> <!-- Buttons -->
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Squash Merge Commit" Style="{StaticResource MaterialDesignHeadline6TextBlock}" Margin="0,0,0,16"/>

        <!-- Content -->
        <StackPanel Grid.Row="1">
            <TextBlock Text="Mensaje del Commit (Squash):" Margin="0,0,0,8" FontWeight="SemiBold"/>
            <Grid>
                 <Grid.ColumnDefinitions>
                     <ColumnDefinition Width="*"/>
                     <ColumnDefinition Width="Auto"/>
                 </Grid.ColumnDefinitions>
                 
                <TextBox Grid.Column="0"
                     x:Name="MessageTextBox"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Height="150"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     materialDesign:HintAssist.Hint="Escribe un mensaje descriptivo para este squash..."
                     materialDesign:TextFieldAssist.HasClearButton="True"/>
                
                 <!-- AI Button -->
                 <Button Grid.Column="1" 
                         x:Name="GenerateAIButton" 
                         Margin="8,0,0,0"
                         VerticalAlignment="Center"
                         ToolTip="Generar mensaje con IA"
                         Style="{StaticResource MaterialDesignIconButton}"
                         Click="GenerateAIButton_Click">
                     <materialDesign:PackIcon Kind="AutoFix" Width="24" Height="24" />
                 </Button>
            </Grid>
           
            <ProgressBar x:Name="AIProgressBar" IsIndeterminate="True" Visibility="Collapsed" Margin="0,8,0,0" Height="4"/>
            
            <TextBlock x:Name="StatusText" Text="" FontSize="12" Foreground="Gray" Margin="0,4,0,0"/>

            <TextBlock Text="Nota: Todos los commits de la rama origen se fusionarán en uno solo con este mensaje." 
                       FontStyle="Italic" Opacity="0.7" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="CANCELAR" IsCancel="True" Style="{StaticResource MaterialDesignFlatButton}" Command="{x:Static materialDesign:DialogHost.CloseDialogCommand}" CommandParameter="False" Margin="0,0,8,0"/>
            <Button x:Name="AcceptButton" Content="SQUASH &amp; COMMIT" Click="AcceptButton_Click" Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</UserControl>
