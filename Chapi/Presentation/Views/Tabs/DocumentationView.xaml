<UserControl x:Class="Chapi.Presentation.Views.Tabs.DocumentationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:doc="clr-namespace:Chapi.Domain.Documentation"
             xmlns:conv="clr-namespace:Chapi.Presentation.Converters"
             Background="#E2E8F0">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:SectionTypeIconConverter x:Key="SectionTypeIconConverter"/>
        <conv:InverseBooleanConverter x:Key="InvBool"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
    </UserControl.Resources>

    <!-- Layout raíz: Sidebar + Contenido principal -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══ SIDEBAR OSCURO ══════════════════════════════════════════════════ -->
        <Border Grid.Column="0" Background="#0F172A">
            <DockPanel>

                <!-- Header del sidebar -->
                <Border DockPanel.Dock="Top" Background="#0A0F1E" Padding="20,18,20,16">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <Border Background="#4F46E5" CornerRadius="8" Padding="6" Margin="0,0,10,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="📄" FontSize="16" LineHeight="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="ChapiDocs" FontWeight="Black" FontSize="15"
                                           Foreground="White" FontFamily="Segoe UI"/>
                                <TextBlock Text="Arquitectura v2.0" FontSize="9" Foreground="#818CF8"
                                           FontFamily="Cascadia Code, Consolas, monospace"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- PLANTILLAS -->
                <StackPanel DockPanel.Dock="Top" Margin="16,14,16,0">
                    <TextBlock Text="PLANTILLAS BASE" FontSize="8" FontWeight="Bold"
                               Foreground="#475569" Margin="2,0,0,8"
                               FontFamily="Cascadia Code, Consolas, monospace"/>
                    <Grid Height="46">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <!-- Modelo Software -->
                        <Button Grid.Column="0" Margin="0,0,4,0" Height="40"
                                Command="{Binding ApplyTemplateCommand}"
                                CommandParameter="{x:Static doc:DocTemplate.ModeloSoftware}"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#1E293B" CornerRadius="10"
                                             BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="📖" FontSize="16" Foreground="#CBD5E1"  HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Modelo Software" FontSize="9"  FontWeight="Bold"
                                                       Foreground="#CBD5E1" HorizontalAlignment="Center"/>                                          
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <!-- Diseño Sistema -->
                        <Button Grid.Column="1" Margin="4,0,0,0" Height="40"
                                Command="{Binding ApplyTemplateCommand}"
                                CommandParameter="{x:Static doc:DocTemplate.DisenoSistema}"
                                Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="#1E293B" CornerRadius="10"
                                            BorderBrush="#334155" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center"  VerticalAlignment="Center">
                                            <TextBlock Text="🏛️" FontSize="16" Foreground="#CBD5E1" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                            <TextBlock Text="Diseño Sistema" FontSize="9" FontWeight="Bold"
                                                       Foreground="#CBD5E1" HorizontalAlignment="Center"/>
                                       
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                                        </Trigger>
                                        <Trigger Property="IsPressed" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- ESTRUCTURA -->
                <DockPanel DockPanel.Dock="Top" Margin="18,16,12,6">
                    <TextBlock DockPanel.Dock="Left" Text="ESTRUCTURA ACTUAL" FontSize="8"
                               FontWeight="Bold" Foreground="#475569" VerticalAlignment="Center"
                               FontFamily="Cascadia Code, Consolas, monospace"/>
                </DockPanel>

                <!-- Lista de secciones -->
                <ListBox DockPanel.Dock="Top"
                         ItemsSource="{Binding Sections}"
                         SelectedItem="{Binding SelectedSection}"
                         Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         Margin="8,0,8,0"
                         MaxHeight="380">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8"
                                                BorderThickness="1" BorderBrush="Transparent">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                                                <Setter TargetName="Bd" Property="BorderBrush" Value="#6366F1"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="#1E293B"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,7,6,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <!-- Icono tipo -->
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Type, Converter={StaticResource SectionTypeIconConverter}}"
                                           FontSize="11" Margin="0,0,7,0"
                                           Foreground="#94A3B8" VerticalAlignment="Center"/>
                                <!-- Título -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Title}" Foreground="#CBD5E1"
                                           FontSize="11" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"/>
                                <!-- Botón eliminar -->
                                <Button Grid.Column="2"
                                        Margin="4,0,0,0"
                                        Command="{Binding DataContext.RemoveSectionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                        CommandParameter="{Binding}"
                                        Cursor="Hand"
                                        ToolTip="Eliminar sección">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="Transparent"
                                                    CornerRadius="4" Padding="4,2">
                                                <TextBlock x:Name="Lbl" Text="✕"
                                                           FontSize="10" FontWeight="Bold"
                                                           Foreground="#475569"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#7F1D1D"/>
                                                    <Setter TargetName="Lbl" Property="Foreground" Value="#FCA5A5"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Botón Guardar y Exportar en la parte inferior -->
                <StackPanel DockPanel.Dock="Bottom" Margin="12,0,12,14">
                    <!-- Guardar -->
                    <Button Command="{Binding SaveCommand}" Margin="0,0,0,6" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#1E293B" CornerRadius="10"
                                         BorderBrush="#334155" BorderThickness="1" >
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="💾" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="GUARDAR" FontSize="10" FontWeight="Black"
                                                   Foreground="#CBD5E1"
                                                   FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#2D3748"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- Exportar Word -->
                    <Button Command="{Binding ExportWordCommand}" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="#059669" CornerRadius="12"
                                         BorderThickness="0" >
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="⬇" FontSize="14" Foreground="White" Margin="0,0,8,0"/>
                                        <TextBlock Text="GENERAR ENTREGABLE" FontSize="10" FontWeight="Black"
                                                   Foreground="White"
                                                   FontFamily="Segoe UI"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#047857"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#065F46"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <!-- Status bar pequeño -->
                <Border DockPanel.Dock="Bottom" Padding="16,6" Background="#0A0F1E">
                    <DockPanel>
                        <ProgressBar DockPanel.Dock="Right" IsIndeterminate="True"
                                     Width="60" Height="3"
                                     Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"
                                     Foreground="#6366F1" Background="Transparent"/>
                        <TextBlock Text="{Binding StatusMessage}" Foreground="#475569"
                                   FontSize="10" VerticalAlignment="Center"
                                   FontFamily="Cascadia Code, Consolas, monospace"
                                   TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>

            </DockPanel>
        </Border>

        <!-- ═══ ÁREA PRINCIPAL: Hoja A4 + Editor + Consola AI ═══════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Fondo gris con la "hoja" A4 centrada -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          Background="#CBD5E1"
                          PanningMode="Both">
                <Grid HorizontalAlignment="Center" Margin="40,32,40,120">

                    <!-- Hoja A4 blanca (816px ≈ Letter width) -->
                    <Border Width="816" MinHeight="1056"
                            Background="White"
                            BorderBrush="#94A3B8" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="40" ShadowDepth="8" Opacity="0.18" Color="#000000"/>
                        </Border.Effect>

                        <Grid>
                            <!-- Plano de fondo de cuadrícula sutil (líneas tipo papel) -->
                            <Grid.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="White" Offset="0"/>
                                    <GradientStop Color="#FAFBFF" Offset="1"/>
                                </LinearGradientBrush>
                            </Grid.Background>

                            <DockPanel Margin="80,60,80,60">

                                <!-- Encabezado del documento -->
                                <Border DockPanel.Dock="Top"
                                        BorderBrush="#1E293B" BorderThickness="0,0,0,3"
                                        Padding="0,0,0,20" Margin="0,0,0,40">
                                    <StackPanel>
                                        <TextBox Text="{Binding Session.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 FontSize="32" FontWeight="Black"
                                                 Foreground="#0F172A"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 TextAlignment="Center"
                                                 HorizontalAlignment="Stretch"
                                                 FontFamily="Segoe UI"/>
                                        <TextBlock Text="Documentación Técnica de Ingeniería — Versión 1.0"
                                                   FontSize="11" Foreground="#64748B"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,8,0,0"
                                                   FontStyle="Italic"
                                                   FontFamily="Georgia, Times New Roman, serif"/>
                                    </StackPanel>
                                </Border>

                                <!-- Footer del documento -->
                                <Border DockPanel.Dock="Bottom"
                                        BorderBrush="#E2E8F0" BorderThickness="0,1,0,0"
                                        Padding="0,14,0,0" Margin="0,20,0,0">
                                    <Grid>
                                        <TextBlock Text="MOD-SYS-EN-2025"
                                                   FontSize="9" Foreground="#94A3B8"
                                                   FontFamily="Cascadia Code, Consolas, monospace"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Left"/>
                                        <TextBlock Text="PROPIEDAD TÉCNICA RESTRINGIDA"
                                                   FontSize="9" Foreground="#94A3B8"
                                                   FontFamily="Cascadia Code, Consolas, monospace"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <!-- Secciones del documento -->
                                <ScrollViewer VerticalScrollBarVisibility="Disabled"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding Sections}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Margin="0,0,0,32"
                                                        Padding="0">
                                                    <StackPanel>

                                                        <!-- Título de la sección -->
                                                        <TextBox Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 FontSize="18" FontWeight="Black"
                                                                 Foreground="#1E293B"
                                                                 Background="Transparent"
                                                                 BorderThickness="0,0,0,3"
                                                                 BorderBrush="#4F46E5"
                                                                 Padding="8,4,0,8"
                                                                 Margin="0,0,0,14"
                                                                 FontFamily="Segoe UI"/>

                                                        <!-- Contenido Texto/Tabla -->
                                                        <TextBox Text="{Binding Content, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Visibility="{Binding IsTextSection, Converter={StaticResource BoolToVis}}"
                                                                 AcceptsReturn="True" AcceptsTab="True"
                                                                 TextWrapping="Wrap"
                                                                 MinHeight="80"
                                                                 VerticalScrollBarVisibility="Auto"
                                                                 FontFamily="Segoe UI" FontSize="13"
                                                                 Foreground="#334155"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Padding="2,0"
                                                                 TextChanged="TextEditor_TextChanged"/>

                                                        <!-- Diagrama: editor + preview -->
                                                        <StackPanel Visibility="{Binding IsDiagramSection, Converter={StaticResource BoolToVis}}"
                                                                    Margin="0,0,0,0">
                                                            <!-- Editor de código de diagrama -->
                                                            <Border Background="#0F172A" CornerRadius="10"
                                                                    Padding="14" Margin="0,0,0,12">
                                                                <StackPanel>
                                                                    <DockPanel Margin="0,0,0,8">
                                                                        <TextBlock DockPanel.Dock="Left"
                                                                                   Text="EDITOR DE DIAGRAMA"
                                                                                   FontSize="9" FontWeight="Bold"
                                                                                   Foreground="#10B981"
                                                                                   FontFamily="Cascadia Code, Consolas, monospace"
                                                                                   VerticalAlignment="Center"/>
                                                                        <ComboBox DockPanel.Dock="Right"

                                                                                  Width="100"
                                                                                  SelectedValue="{Binding DiagramFormat, Mode=TwoWay}"
                                                                                  SelectedValuePath="Tag"
                                                                                  Background="#1E293B"
                                                                                  Foreground="White"
                                                                                  FontSize="10">
                                                                            <ComboBoxItem Content="MERMAID" Tag="{x:Static doc:DiagramFormat.Mermaid}"/>
                                                                            <ComboBoxItem Content="PLANTUML" Tag="{x:Static doc:DiagramFormat.PlantUml}"/>
                                                                        </ComboBox>
                                                                    </DockPanel>
                                                                    <TextBox Text="{Binding DiagramCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                             AcceptsReturn="True" AcceptsTab="True"
                                                                             MinHeight="100"
                                                                             TextWrapping="Wrap"
                                                                             FontFamily="Cascadia Code, Consolas, monospace"
                                                                             FontSize="12"
                                                                             Foreground="#A5B4FC"
                                                                             Background="Transparent"
                                                                             CaretBrush="#818CF8"
                                                                             BorderThickness="0"
                                                                             TextChanged="DiagramEditor_TextChanged"/>
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>

                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                            </DockPanel>
                        </Grid>
                    </Border>

                    <!-- WebView2 flotante para preview de diagramas (oculto por defecto) -->
                    <wpf:WebView2 x:Name="PreviewWebView"
                                  Visibility="Collapsed"
                                  Width="0" Height="0"/>
                </Grid>
            </ScrollViewer>

            <!-- ══ CONSOLA AI FLOTANTE (dock al fondo) ═════════════════════════ -->
            <Border Grid.Row="1"
                    Background="#0F172A"
                    BorderBrush="#1E293B" BorderThickness="0,1,0,0"
                    Padding="20,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icono IA -->
                    <Border Grid.Column="0"
                            Background="#4F46E5" CornerRadius="10"
                            Padding="10" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="✨" FontSize="16"/>
                    </Border>

                    <!-- Input prompt -->
                    <TextBox Grid.Column="1"
                             x:Name="AiPromptBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#E2E8F0"
                             CaretBrush="#818CF8"
                             FontSize="13"
                             VerticalAlignment="Center"
                             FontFamily="Segoe UI"
                             Tag="Escribe qué diagrama o sección quieres generar..."
                             KeyDown="AiPromptBox_KeyDown">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter Property="Background">
                                            <Setter.Value>
                                                <VisualBrush Stretch="None" AlignmentX="Left">
                                                    <VisualBrush.Visual>
                                                        <TextBlock Text="Escribe qué diagrama o sección quieres generar..."
                                                                   Foreground="#475569"
                                                                   FontSize="13"
                                                                   FontFamily="Segoe UI"/>
                                                    </VisualBrush.Visual>
                                                </VisualBrush>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>

                    <!-- Checkbox Generar Todo -->
                    <CheckBox Grid.Column="2"
                              Content="Generar Todo"
                              IsChecked="{Binding GenerateAll}"
                              Foreground="#94A3B8"
                              FontSize="11"
                              FontWeight="SemiBold"
                              VerticalAlignment="Center"
                              Margin="0,0,16,0"/>

                    <!-- Sección seleccionada -->
                    <TextBlock Grid.Column="3"
                               Text="{Binding SelectedSection.Title, StringFormat='→ {0}', FallbackValue='→ sin sección'}"
                               Foreground="#475569"
                               FontSize="10"
                               Visibility="{Binding GenerateAll, Converter={StaticResource InvBoolToVis}}"
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"
                               FontFamily="Cascadia Code, Consolas, monospace"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="160"/>

                    <!-- Botón Generar -->
                    <Button Grid.Column="4"
                            x:Name="AiGenerateButton"
                            Click="AiGenerateButton_Click"
                            IsEnabled="{Binding IsGenerating, Converter={StaticResource InvBool}}"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        Background="White" CornerRadius="10"
                                        Padding="18,10"
                                        BorderThickness="0">
                                    <TextBlock x:Name="Lbl"
                                               Text="Iniciar Análisis AI"
                                               FontSize="11" FontWeight="Black"
                                               Foreground="#0F172A"
                                               FontFamily="Segoe UI"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#6366F1"/>
                                        <Setter TargetName="Lbl" Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#4338CA"/>
                                        <Setter TargetName="Lbl" Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="Bd" Property="Background" Value="#334155"/>
                                        <Setter TargetName="Lbl" Property="Text" Value="Analizando..."/>
                                        <Setter TargetName="Lbl" Property="Foreground" Value="#64748B"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
