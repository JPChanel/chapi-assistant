<UserControl x:Class="Chapi.Presentation.Alerts.NotificationHost"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d">
    <Border MaxWidth="420"
            Padding="18"
            Background="{Binding CurrentBackgroundBrush}"
            BorderBrush="{Binding CurrentBorderBrush}"
            BorderThickness="1"
            CornerRadius="20"
            Effect="{DynamicResource MaterialDesignElevationShadow4}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsOpen}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Width="42"
                    Height="42"
                    VerticalAlignment="Top"
                    Background="#19FFFFFF"
                    CornerRadius="21">
                <materialDesign:PackIcon Width="22"
                                         Height="22"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Foreground="{Binding CurrentForegroundBrush}"
                                         Kind="{Binding CurrentIconKind}" />
            </Border>

            <StackPanel Grid.Column="1"
                        Margin="14,0,0,0">
                <TextBlock FontSize="15"
                           FontWeight="Bold"
                           Foreground="{Binding CurrentForegroundBrush}"
                           Text="{Binding CurrentTitle}" />
                <TextBlock Margin="0,6,0,0"
                           Foreground="{Binding CurrentForegroundBrush}"
                           Opacity="0.92"
                           Text="{Binding CurrentMessage}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
