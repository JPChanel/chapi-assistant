<Window x:Class="Chapi.Presentation.Features.ActivityOverview.Views.ActivityOverviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:estControls="clr-namespace:app_desktop_base.Controls"
        mc:Ignorable="d"
        Title="Actividad general"
        Height="720"
        Width="1280"
        MinHeight="620"
        MinWidth="1040"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Actividad general"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="{DynamicResource MaterialDesignBody}"/>
            <TextBlock Text="{Binding StatusMessage}"
                       Margin="0,6,0,0"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,18,0,0">
            <estControls:EstDataTable Data="{Binding Activities}"
                                      Column="{Binding TableDefinition}"
                                      TopToolbarCustomActions="{Binding ToolbarActions}"
                                      SelectedItem="{Binding SelectedActivity, Mode=TwoWay}"
                                      AllowCreate="False"
                                      AllowDelete="False"
                                      AllowInlineEdit="False"
                                      AllowResetState="True"
                                      AllowColumnVisibilityToggle="True"
                                      ShowRowNumbers="True"
                                      ShowRowActions="False"
                                      PageSize="25"/>

            <Border Background="#AAFFFFFF"
                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"
                    Panel.ZIndex="2">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="240" Height="6" IsIndeterminate="True"/>
                    <TextBlock Text="Cargando resumen global..." Margin="0,12,0,0" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
