<UserControl x:Class="Chapi.Presentation.Features.Changes.Views.ChangesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chapi.Presentation.Features.Changes.Views"
             xmlns:entities="clr-namespace:Chapi.Domain.Entities"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:Chapi.Presentation.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    
    <UserControl.Resources>
        <converters:IntegerToVisibilityConverter x:Key="IntegerToVisibilityConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:EmailToGravatarConverter x:Key="EmailToGravatarConverter"/>
        <converters:GitHubAvatarConverter x:Key="GitHubAvatarConverter"/>
        <converters:GitProviderAvatarConverter x:Key="GitProviderAvatarConverter"/>
    </UserControl.Resources>

    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Background="{DynamicResource MaterialDesignPaper}">
        <StackPanel x:Name="GitMissingView" 
                    Visibility="Collapsed"
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center"
                    Margin="20">

            <materialDesign:PackIcon Kind="GiftOff" 
                                     Width="80" Height="80" 
                                     HorizontalAlignment="Center" 
                                     Foreground="{DynamicResource MaterialDesignCheckBoxDisabled}"/>

            <TextBlock Text="Git no se encuentra" 
                       Style="{StaticResource MaterialDesignHeadline5TextBlock}" 
                       HorizontalAlignment="Center" 
                       Margin="0,16,0,0"/>

            <TextBlock Text="Chapi necesita Git para rastrear cambios, ver el historial y gestionar commits. Parece que no esta instalado o no se agrego al PATH del sistema."
                       Style="{StaticResource MaterialDesignBody1TextBlock}"
                       TextWrapping="Wrap" 
                       TextAlignment="Center"
                       MaxWidth="500" 
                       Margin="0,10,0,20"/>

            <Button x:Name="btnInstallGit" 
                    Content="Descargar e Instalar Git"
                    Click="btnInstallGit_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"
                    HorizontalAlignment="Center"
                    materialDesign:ButtonAssist.CornerRadius="6"/>

            <Button x:Name="btnRefreshGitCheck" 
                    Content="Volver a Comprobar"
                    Click="btnRefreshGitCheck_Click"
                    Style="{StaticResource MaterialDesignFlatButton}"
                    HorizontalAlignment="Center" 
                    Margin="0,10,0,0"/>
        </StackPanel>

        <Grid x:Name="GitControlsView" 
              Visibility="Visible"
              VerticalAlignment="Stretch">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.4*" MinWidth="250"/>
                <ColumnDefinition Width="0.6*"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" VerticalAlignment="Stretch" Background="{DynamicResource MaterialDesignPaper}">
                <DockPanel x:Name="NormalChangesView"
                           Margin="0"
                           LastChildFill="True"
                           VerticalAlignment="Stretch"
                           HorizontalAlignment="Stretch"
                           Visibility="{Binding IsStashViewVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">

                    <!-- Header Lista -->
                    <Border DockPanel.Dock="Top" Padding="12,8"  BorderBrush="{x:Null}" BorderThickness="0">
                        <Grid>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="SourceCommit" Foreground="{DynamicResource StatusInfoBrush}" VerticalAlignment="Center" Margin="0,0,8,0" Width="16" Height="16"/>
                                <TextBlock Text="Cambios" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" Foreground="{DynamicResource ActionTextOnAccentBrush}" Opacity="1"/>
                                <Border Background="{DynamicResource AppPrimaryBrush}" CornerRadius="4" Padding="4,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="txtChangesCountSide" Text="{Binding TotalChangesCount}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource ActionTextOnAccentBrush}" Opacity="0.9"/>
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center" x:Name="pnlTotalLineStats">
                                    <TextBlock Text="{Binding TotalAdditions, StringFormat='+{0}'}" 
                                               Foreground="{DynamicResource StatusSuccessBrush}" FontSize="10" FontWeight="Bold" Margin="0,0,5,0"
                                               Visibility="{Binding TotalAdditions, Converter={StaticResource IntegerToVisibilityConverter}}"/>
                                    <TextBlock Text="{Binding TotalDeletions, StringFormat='-{0}'}" 
                                               Foreground="{DynamicResource StatusDangerBrush}" FontSize="10" FontWeight="Bold"
                                               Visibility="{Binding TotalDeletions, Converter={StaticResource IntegerToVisibilityConverter}}"/>
                                </StackPanel>
                            </StackPanel>
                            <CheckBox x:Name="SelectAllCheckBox" HorizontalAlignment="Right" Content="Seleccionar" FontSize="10" Foreground="{DynamicResource ActionTextOnAccentBrush}" Opacity="0.8" IsChecked="{Binding AreAllSelected, Mode=TwoWay}" VerticalAlignment="Center">
                                <CheckBox.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Stash todos los cambios" Click="StashSelectedMenuItem_Click">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="ArchiveArrowDownOutline"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Header="Descartar Todos los cambios" Click="DiscardAllChangesMenuItem_Click" Foreground="{DynamicResource StatusDangerBrush}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="DeleteForever" Foreground="{DynamicResource StatusDangerBrush}"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </CheckBox.ContextMenu>
                            </CheckBox>
                        </Grid>
                    </Border>

                    <!-- Banner de Conflictos -->
                    <Border DockPanel.Dock="Top"
                            Visibility="{Binding HasConflicts, Converter={StaticResource BooleanToVisibilityConverter}}"
                            Background="{DynamicResource StatusWarningMutedBackgroundBrush}"
                            BorderBrush="{DynamicResource StatusWarningBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="8,6"
                            Margin="8,2,8,6">
                        <DockPanel LastChildFill="True">
                            <Button DockPanel.Dock="Right"
                                    Content="Resolver"
                                    Command="{Binding ResolveConflictsCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource StatusWarningBrush}"
                                    Foreground="{DynamicResource ActionTextOnAccentBrush}"
                                    Height="24"
                                    Padding="8,0"
                                    FontSize="11"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <materialDesign:PackIcon Kind="AlertOctagon" Foreground="{DynamicResource StatusWarningBrush}" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ConflictsCount, StringFormat='{}{0} conflicto(s) pendiente(s)'}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource StatusWarningBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- SECCION DE COMMIT -->
                    <Border x:Name="ChangesFooterPanel" DockPanel.Dock="Bottom" Padding="12,10" Margin="0"  BorderBrush="{x:Null}" BorderThickness="0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="MENSAJE DE COMMIT"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               VerticalAlignment="Center"
                                               Margin="0,0,10,0"/>
                                    <Button Command="{Binding ConnectAccountCommand}"
                                            Style="{StaticResource MaterialDesignFlatButton}"
                                            Padding="0"
                                            Margin="0,0,10,0"
                                            Height="Auto"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsAuthenticated, Converter={StaticResource BooleanToVisibilityConverter}}"
                                            ToolTip="Gestionar cuenta Git">
                                        <Border CornerRadius="10"
                                                Background="{DynamicResource MaterialDesignCardBackground}"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}"
                                                BorderThickness="1"
                                                Padding="8,3">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="{Binding ProviderIcon}"
                                                                         Foreground="{DynamicResource AppPrimaryBrush}"
                                                                         Width="12"
                                                                         Height="12"
                                                                         VerticalAlignment="Center"
                                                                         Margin="0,0,5,0"/>
                                                <TextBlock Text="{Binding AuthenticatedUserName}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource MaterialDesignBody}"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </Button>
                                </StackPanel>

                                <Button x:Name="btnGitCommitIA"
                                        Grid.Column="1"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Padding="4,2"
                                        Height="Auto"
                                        ToolTip="Autocompletar con IA"
                                        Click="btnGitCommitIA_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="AutoFix"
                                                                 Foreground="{DynamicResource StatusInfoBrush}"
                                                                 Width="15"
                                                                 Height="15"
                                                                 Margin="0,0,5,0"
                                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Autocompletar"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>
                            </Grid>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Avatar de GitHub/GitLab -->
                                <Border Grid.Column="0" 
                                        Width="40" 
                                        Height="40" 
                                        CornerRadius="20" 
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Top"
                                        BorderBrush="{DynamicResource AppBorderBrush}"
                                        BorderThickness="0"
                                        ToolTip="{Binding DisplayUserName, StringFormat='@{0}'}">
                                    <Border.Clip>
                                        <EllipseGeometry Center="20,20" RadiusX="20" RadiusY="20"/>
                                    </Border.Clip>
                                    <Image Stretch="UniformToFill">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource GitProviderAvatarConverter}" ConverterParameter="80">
                                                <Binding Path="DisplayUserName"/>
                                                <Binding Path="AuthenticatedProvider"/>
                                                <Binding Path="GitUserEmail"/>
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                </Border>
                                
                                <!-- Campo de mensaje -->
                                <TextBox x:Name="txtCommitSummary"
                                         Grid.Column="1"
                                         materialDesign:HintAssist.Hint="Resumen del commit"
                                         Text="{Binding CommitSummary, UpdateSourceTrigger=PropertyChanged}"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"/>
                            </Grid>

                            <TextBox x:Name="txtCommitDescription"
                                     materialDesign:HintAssist.Hint="Descripcion (opcional)"
                                     MinHeight="80"
                                     MaxHeight="150"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Hidden"
                                     Text="{Binding CommitDescription, UpdateSourceTrigger=PropertyChanged}"
                                     Margin="0,0,0,10"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"/>

                            <Button x:Name="btnCommit"
                                    Command="{Binding CommitCommand}"
                                    Style="{StaticResource MaterialDesignRaisedButton}"
                                    Background="{DynamicResource AppPrimaryBrush}"
                                    Foreground="{DynamicResource ActionTextOnAccentBrush}"
                                    BorderBrush="{DynamicResource AppPrimaryBrush}"
                                    Height="38"
                                    FontWeight="Bold"
                                    materialDesign:ButtonAssist.CornerRadius="6">
                                <TextBlock Text="{Binding SelectedCount, StringFormat='CONFIRMAR COMMIT ({0})'}" />
                            </Button>
                        </StackPanel>
                    </Border>
                    
                    <Expander x:Name="StashExpander"
                              DockPanel.Dock="Bottom"
                              Margin="0,5,0,0"
                              materialDesign:ExpanderAssist.HeaderBackground="{DynamicResource MaterialDesignPaper}"
                              BorderBrush="{DynamicResource MaterialDesignDivider}"
                              BorderThickness="0,1,0,0">
                        <Expander.Style>
                            <Style TargetType="Expander" BasedOn="{StaticResource MaterialDesignExpander}">
                                <Setter Property="Visibility" Value="{Binding HasStashes, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Style>
                        </Expander.Style>
                        <Expander.Header>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="StashExpanderHeader"
                                           Text="{Binding Stashes.Count, StringFormat='Stashed Changes ({0})'}"
                                           Grid.Column="0"
                                           FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Margin="5,0"/>

                                <Button x:Name="RestoreLatestStashButton"
                                        Grid.Column="1"
                                        Content="Restaurar"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Click="RestoreLatestStashButton_Click"
                                        ToolTip="Restaura el stash más reciente (o el primero de la lista)"
                                        Foreground="{DynamicResource StatusInfoBrush}"/>

                                <Button x:Name="DiscardAllStashesButton"
                                        Grid.Column="2"
                                        Content="Descartar"
                                        Style="{StaticResource MaterialDesignFlatButton}"
                                        Click="DiscardAllStashesButton_Click"
                                        ToolTip="Elimina permanentemente TODOS los stashes"
                                        Foreground="{DynamicResource StatusDangerBrush}"/>
                            </Grid>
                        </Expander.Header>
                        <ListView x:Name="StashListView"
                                  ItemsSource="{Binding Stashes}"
                                  MaxHeight="150"
                                  ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                  SelectionChanged="StashListView_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate DataType="{x:Type entities:GitStash}">
                                    <Grid Margin="5" HorizontalAlignment="Stretch">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Message}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding Branch, StringFormat='[{0}]'}" 
                                                           Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                           FontSize="11" FontWeight="Medium" 
                                                           Margin="0,0,6,0"/>
                                                <TextBlock Text="{Binding FileCount, StringFormat='{}{0} archivos'}" 
                                                           Foreground="{DynamicResource MaterialDesignBody}" 
                                                           Opacity="0.7" FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="RestoreStashItemButton"
                                                Grid.Column="1"
                                                Content="Restaurar"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Foreground="{DynamicResource StatusInfoBrush}"
                                                Click="RestoreStashItemButton_Click"
                                                CommandParameter="{Binding}"
                                                Margin="10,0,5,0"/>
                                        <Button x:Name="DiscardStashItemButton"
                                                Grid.Column="2"
                                                Content="Descartar"
                                                Style="{StaticResource MaterialDesignFlatButton}"
                                                Click="DiscardStashItemButton_Click"
                                                CommandParameter="{Binding}"
                                                Foreground="{DynamicResource StatusDangerBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>

                    <ListView x:Name="ChangesListView" 
                              ItemsSource="{Binding Changes}"
                              SelectedItem="{Binding SelectedChange}"
                              VerticalAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              Padding="0,2"
                              Background="Transparent"
                              materialDesign:TransitionAssist.DisableTransitions="True"
                              ScrollViewer.CanContentScroll="True"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              VirtualizingPanel.CacheLengthUnit="Page"
                              VirtualizingPanel.CacheLength="1"
                              SelectionChanged="ChangesListView_SelectionChanged">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource MaterialDesignListBoxItem}">
                                <Setter Property="materialDesign:RippleAssist.IsDisabled" Value="True"/>
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="ItemBorder"
                                        Padding="8,6" 
                                        Background="{DynamicResource MaterialDesignCardBackground}" 
                                        CornerRadius="6" 
                                        BorderBrush="{DynamicResource MaterialDesignDivider}" 
                                        BorderThickness="1"
                                        Margin="4,1">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Descartar Cambios"
                                                      Click="DiscardChangesMenuItem_Click"
                                                      CommandParameter="{Binding}"
                                                      Foreground="{DynamicResource StatusDangerBrush}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="UndoVariant" Foreground="{DynamicResource StatusDangerBrush}"/>
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Abrir en Antigravity" Click="ProjectMenuItem_OpenAntigravity_Click" CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="Atom" Foreground="{DynamicResource PrimaryHueMidBrush}" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Abrir en VS Code" Click="ProjectMenuItem_OpenVSCode_Click" CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="MicrosoftVisualStudioCode" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Header="Abrir en Visual Studio" Click="ProjectMenuItem_OpenVisualStudio_Click" CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="VisualStudio" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator />
                                            <MenuItem Header="Mostrar en el Explorador" Click="ProjectMenuItem_OpenExplorer_Click" CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FolderOpenOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <Grid Background="Transparent">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Checkbox -->
                                        <CheckBox Grid.Column="0"
                                                  IsChecked="{Binding IsSelected}"
                                                  VerticalAlignment="Center"
                                                  Margin="0,0,10,0">
                                            <CheckBox.LayoutTransform>
                                                <ScaleTransform ScaleX="0.9" ScaleY="0.9"/>
                                            </CheckBox.LayoutTransform>
                                        </CheckBox>

                                        <!-- File Info -->
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding FileName}" 
                                                       FontWeight="Bold" 
                                                       FontSize="12" 
                                                       Foreground="{DynamicResource MaterialDesignBody}" 
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding DirectoryPath}" 
                                                       FontSize="9" 
                                                       Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                       Margin="0,1,0,0" 
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>

                                        <!-- Line Stats -->
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0">
                                            <TextBlock Text="{Binding Additions, StringFormat='+{0}'}" 
                                                       Foreground="{DynamicResource StatusSuccessBrush}" 
                                                       FontSize="10" 
                                                       FontWeight="Bold"
                                                       Margin="0,0,6,0"
                                                       Visibility="{Binding Additions, Converter={StaticResource IntegerToVisibilityConverter}}"/>
                                            <TextBlock Text="{Binding Deletions, StringFormat='-{0}'}" 
                                                       Foreground="{DynamicResource StatusDangerBrush}" 
                                                       FontSize="10" 
                                                       FontWeight="Bold"
                                                       Visibility="{Binding Deletions, Converter={StaticResource IntegerToVisibilityConverter}}"/>
                                        </StackPanel>

                                        <!-- Status Badge -->
                                        <Border Grid.Column="3" 
                                                Background="Transparent" 
                                                CornerRadius="3" 
                                                BorderBrush="{Binding Color}" 
                                                BorderThickness="1" 
                                                Width="18" 
                                                Height="18" 
                                                HorizontalAlignment="Right" 
                                                VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ShortStatus}" 
                                                       Foreground="{Binding Color}" 
                                                       FontWeight="Bold" 
                                                       FontSize="9" 
                                                       HorizontalAlignment="Center" 
                                                       VerticalAlignment="Center"/>
                                        </Border>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>

                <DockPanel x:Name="StashedChangesView" 
                           Margin="5" 
                           LastChildFill="True" 
                           Visibility="{Binding IsStashViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">

                    <Border DockPanel.Dock="Top"
                            Background="{DynamicResource MaterialDesignPaper}"
                            BorderBrush="{DynamicResource MaterialDesignDivider}"
                            BorderThickness="0,0,0,1"
                            Padding="8,4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Button x:Name="StashView_RestoreButton"
                                    Grid.Column="0"
                                    Content="Restaurar"
                                    Height="24"
                                    FontSize="11"
                                    Padding="10,0"
                                    Click="StashView_RestoreButton_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{DynamicResource StatusInfoBrush}"
                                    BorderBrush="{DynamicResource StatusInfoBrush}"/>

                            <Button x:Name="StashView_DiscardButton"
                                    Grid.Column="1"
                                    Content="Descartar"
                                    Height="24"
                                    FontSize="11"
                                    Padding="10,0"
                                    Click="StashView_DiscardButton_Click"
                                    Style="{StaticResource MaterialDesignOutlinedButton}"
                                    Foreground="{DynamicResource StatusDangerBrush}"
                                    BorderBrush="{DynamicResource StatusDangerBrush}"
                                    Margin="6,0,0,0"/>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0">
                                <TextBlock Text="{Binding SelectedStash.Message}" FontWeight="SemiBold" FontSize="11" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding StashedFiles.Count, StringFormat='{}{0} archivos en este stash'}" 
                                           FontSize="10" Opacity="0.7" 
                                           Foreground="{DynamicResource MaterialDesignBody}"/>
                            </StackPanel>

                            <Button x:Name="StashView_BackButton"
                                    Grid.Column="3"
                                    Content="Volver"
                                    Height="24"
                                    FontSize="12"
                                    Padding="8,0"
                                    Click="StashView_BackButton_Click"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ListView x:Name="StashFilesListView"
                              ItemsSource="{Binding StashedFiles}"
                              SelectedItem="{Binding SelectedStashedFile}"
                              VerticalAlignment="Stretch"
                              VerticalContentAlignment="Stretch"
                              Margin="0,0,0,5"
                              SelectionChanged="StashFilesListView_SelectionChanged">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding FilePath}"
                                               ToolTip="{Binding Status}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,0,10,0"/>

                                    <materialDesign:PackIcon Grid.Column="1"
                                               Kind="{Binding Icon}"
                                               Foreground="{Binding Color}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               Margin="0,0,5,0"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </DockPanel>
            </Grid>

            <Grid Grid.Column="1" Margin="1,0,0,0" Background="{DynamicResource MaterialDesignCardBackground}" VerticalAlignment="Stretch">
                <!-- Empty State View -->
                <Grid x:Name="DiffEmptyStateView" 
                      Grid.Column="1"
                      Visibility="Visible" 
                      HorizontalAlignment="Center" 
                      VerticalAlignment="Center">
                    <StackPanel HorizontalAlignment="Center">
                        <materialDesign:PackIcon Kind="CodeGreaterThan" 
                                                 Width="64" 
                                                 Height="64" 
                                                 Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                                 HorizontalAlignment="Center" 
                                                 Margin="0,0,0,20"/>
                        
                        <TextBlock Text="SIN ARCHIVO SELECCIONADO" 
                                   FontSize="14" 
                                   FontWeight="Bold" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                   HorizontalAlignment="Center"/>
                        
                        <TextBlock Text="Selecciona un archivo modificado en el panel&#x0a;izquierdo para ver las diferencias (diff)." 
                                   FontSize="12" 
                                   Foreground="{DynamicResource MaterialDesignBodyLight}" 
                                   TextAlignment="Center" 
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Grid>

                <!-- Diff View -->
                <!-- Diff View -->
                <Border x:Name="DiffContentBorder" 
                        Grid.Column="1"
                        Visibility="{Binding DiffLines.Count, Converter={StaticResource IntegerToVisibilityConverter}}"
                        Background="{DynamicResource MaterialDesignCardBackground}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DiffLinesItemsControl" 
                                      ItemsSource="{Binding DiffLines}"
                                      FontFamily="Consolas" 
                                      FontSize="13" 
                                      Background="{DynamicResource MaterialDesignPaper}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid ContextMenuOpening="DiffLine_ContextMenuOpening">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem x:Name="DiffLineMenu_OpenFile"
                                                          Header="Open with default program"
                                                          Click="DiffLineMenu_OpenFile_Click"
                                                          FontWeight="Bold">
                                                    <MenuItem.Icon>
                                                        <materialDesign:PackIcon Kind="MicrosoftVisualStudioCode" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Grid.ContextMenu>

                                        <Grid.Style>
                                            <Style TargetType="Grid">
                                                <Setter Property="Background" Value="Transparent"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Type}" Value="Inserted">
                                                        <Setter Property="Background" Value="{DynamicResource StatusDiffInsertedBackgroundBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Deleted">
                                                        <Setter Property="Background" Value="{DynamicResource StatusDiffDeletedBackgroundBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Type}" Value="Imaginary">
                                                        <Setter Property="Background" Value="{DynamicResource MaterialDesignDivider}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Grid.Style>

                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="35"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Position}" Foreground="{DynamicResource MaterialDesignBodyLight}" Padding="5,0" HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Inserted">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Imaginary">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="1" Text="{Binding Position}" Foreground="{DynamicResource MaterialDesignBodyLight}" Padding="5,0" HorizontalAlignment="Right">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Deleted">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Imaginary">
                                                            <Setter Property="Visibility" Value="Hidden"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>

                                        <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="NoWrap" FontFamily="Consolas" Padding="12,2,0,2">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding Text, StringFormat='  {0}'}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type}" Value="Inserted">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusDiffInsertedForegroundBrush}"/>
                                                            <Setter Property="Text" Value="{Binding Text, StringFormat='+ {0}'}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Deleted">
                                                            <Setter Property="Foreground" Value="{DynamicResource StatusDiffDeletedForegroundBrush}"/>
                                                            <Setter Property="Text" Value="{Binding Text, StringFormat='- {0}'}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Unchanged">
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type}" Value="Imaginary">
                                                            <Setter Property="Text" Value="..."/>
                                                            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>

