<Window x:Class="Chapi.Presentation.Features.Agent.Views.AddMethodView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="Agregar Metodo"
        Width="850"
SizeToContent="Height" MaxHeight="800"
        MinWidth="750"
        WindowStartupLocation="CenterScreen"
        
        Background="{DynamicResource MaterialDesignPaper}">

    <Window.Resources />

    <Grid  Margin="20"
      VerticalAlignment="Top"
      HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Header -->
            <RowDefinition Height="*"/>
            <!-- Contenido con Scroll -->
            <RowDefinition Height="Auto"/>
            <!-- Footer -->
        </Grid.RowDefinitions>

        <!-- 🧱 HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Titulos -->
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <materialDesign:PackIcon Kind="RocketLaunch" Width="28" Height="28" Margin="0,0,10,0" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="Agregar Metodo"
                               FontSize="28"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="Genera metodos automaticamente con o sin asistencia de IA"
                   Foreground="{DynamicResource MaterialDesignBodyLight}"
                   FontSize="13"
                   FontStyle="Italic"/>
            </StackPanel>

            <!-- Checkbox moderno -->
            <Border Grid.Column="1"
            CornerRadius="6"
            Background="{DynamicResource PrimaryHueLightBrush}"
            Padding="10,6"
            VerticalAlignment="Center"
            Margin="8,0,0,0"
            BorderBrush="{DynamicResource PrimaryHueLightBrush}"
            BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="chkUseIA"
                      VerticalAlignment="Center"
                      Checked="chkUseIA_Checked"
                      Unchecked="chkUseIA_Unchecked">
                        <CheckBox.Content>
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Robot" 
                                                         Width="20" 
                                                         Height="20" 
                                                         Margin="0,0,8,0" 
                                                         Foreground="{DynamicResource PrimaryHueMidBrush}" 
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="Modo Avanzado (IA)"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                            </StackPanel>
                        </CheckBox.Content>
                    </CheckBox>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 🧭 CONTENIDO SCROLLEABLE -->
        <ScrollViewer Grid.Row="1"
              VerticalScrollBarVisibility="Auto"
              HorizontalScrollBarVisibility="Disabled"
              PanningMode="Both"
              CanContentScroll="True"
              ScrollViewer.IsDeferredScrollingEnabled="True">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- PANEL MANUAL -->
                <StackPanel x:Name="methotPanel" Margin="10" Grid.Row="0">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="15"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Configuracion Basica -->
                        <StackPanel Grid.Column="0">
                             <!-- Estilo de API -->
                             <GroupBox Margin="0,0,0,15"
                                       Style="{StaticResource MaterialDesignCardGroupBox}">
                                 <GroupBox.Header>
                                     <StackPanel Orientation="Horizontal">
                                         <materialDesign:PackIcon Kind="Api" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                         <TextBlock Text="Estilo de API" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                     </StackPanel>
                                 </GroupBox.Header>
                                 <StackPanel Margin="10">
                                     <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                         <RadioButton x:Name="rbController"
                                                      Content="Controller (Clasico)"
                                                      Margin="0,0,15,0"
                                                      IsChecked="True"
                                                      GroupName="ApiStyle"/>
                                         <RadioButton x:Name="rbEndpoint"
                                                      Content="Endpoint (Ardalis)"
                                                      GroupName="ApiStyle"/>
                                     </StackPanel>
                                     
                                     <CheckBox x:Name="chkIncludeAppLayer"
                                               Content="Incluir Capa Aplicacion (Service)"
                                               IsChecked="False"
                                               ToolTip="Si se marca, el Endpoint llamara a un servicio de Aplicacion."/>
                                 </StackPanel>
                             </GroupBox>

                            <GroupBox Style="{StaticResource MaterialDesignCardGroupBox}">
                                <GroupBox.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="ClipboardTextOutline" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Configuracion Basica" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </GroupBox.Header>
                                <StackPanel Margin="15">
                                    <ComboBox x:Name="cboModulo"
                                          materialDesign:HintAssist.Hint="Seleccione o Escriba Modulo"
                                          IsEditable="True"
                                          Margin="0,0,0,10"
                                          FontSize="14"/>
                                    
                                    <TextBox x:Name="txtMetodo"
                                             materialDesign:HintAssist.Hint="Nombre del Metodo (opcional)"
                                             Margin="0,0,0,10"
                                             FontSize="14"/>
                                    <ComboBox x:Name="cbobd"
                                              materialDesign:HintAssist.Hint="Base de Datos"
                                              FontSize="14">
                                        <ComboBoxItem Content="Postgres"/>
                                        <ComboBoxItem Content="Sybase"/>
                                    </ComboBox>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Operaciones HTTP -->
                        <GroupBox Grid.Column="2"
                                  Style="{StaticResource MaterialDesignCardGroupBox}" VerticalAlignment="Top">
                            <GroupBox.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="Web" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Operaciones HTTP" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                </StackPanel>
                            </GroupBox.Header>
                            <StackPanel Margin="10">
                                <CheckBox x:Name="checkPost"
                                          Content="POST - Crear/Ejecutar"
                                          Margin="0,5"/>
                                <CheckBox x:Name="checkGet"
                                          Content="GET - Busqueda/Listar (Search)"
                                          Margin="0,5"/>
                                <CheckBox x:Name="checkGetById"
                                          Content="GET by ID - Buscar por codigo (Find)"
                                          Margin="0,5"/>
                            </StackPanel>
                        </GroupBox>
                    </Grid>
                </StackPanel>

                <!-- PANEL IA -->
                <StackPanel x:Name="iaPanel" Margin="10" Grid.Row="1" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- 🧠 Ayuda -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource MaterialDesignSelection}"
                                Padding="15"
                                CornerRadius="5"
                                Margin="10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <materialDesign:PackIcon Kind="LightbulbOnOutline" Width="18" Height="18" Foreground="{DynamicResource StatusWarningBrush}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="¿Cómo funciona?"
                                               FontWeight="Bold"
                                               FontSize="14"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="Pega el correo con el detalle del procedimiento almacenado y deja que la IA analice los parametros y genere automaticamente las capas necesarias."
                                           TextWrapping="Wrap"
                                           FontSize="12"
                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                            </StackPanel>
                        </Border>

                        <!-- Panel de Contenido -->
                        <Grid Grid.Row="1">

                            <!-- 📥 Panel Input -->
                            <Grid x:Name="panelInput" Visibility="Visible">
                              
                                    <StackPanel Margin="20" >
                                        <GroupBox Style="{StaticResource MaterialDesignCardGroupBox}">
                                            <GroupBox.Header>
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon Kind="EmailOutline" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                    <TextBlock Text="Correo Tecnico" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                </StackPanel>
                                            </GroupBox.Header>
                                            <StackPanel Margin="15">
                                                <TextBlock Text="Pegue aqui el correo con la definicion del SP:"
                                                           Margin="0,0,0,10"
                                                           Foreground="{DynamicResource MaterialDesignBodyLight}"/>
                                                <TextBox x:Name="txtEmailContent"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         MinHeight="300"
                                                         FontFamily="Consolas"
                                                         FontSize="12"
                                                         materialDesign:HintAssist.Hint="Ejemplo: El SP se llama sp_buscar_productos, recibe @codigo int, @nombre varchar(50)..."/>
                                                <Button x:Name="btnAnalyze"
                                                        Margin="0,15,0,0"
                                                        Click="btnAnalyze_Click"
                                                        ToolTip="Analizar con Inteligencia Artificial"
                                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                                        Height="40">
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="AutoFix" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Analizar con IA" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </GroupBox>
                                    </StackPanel>
                               
                            </Grid>

                            <!-- ⏳ Panel Analizando -->
                            <Grid x:Name="panelAnalyzing" Visibility="Collapsed">
                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 IsIndeterminate="True"
                                                 Width="60"
                                                 Height="60"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                                        <materialDesign:PackIcon Kind="Robot" Margin="0,0,10,0" Width="24" Height="24" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Text="Analizando con IA..."
                                                   FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="txtAnalyzingStatus"
                                               Text="Extrayendo informacion..."
                                               FontSize="12"
                                               Foreground="{DynamicResource MaterialDesignBodyLight}"
                                               Margin="0,10,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>

                            <!-- 📄 Panel Resultados -->
                            <ScrollViewer x:Name="panelResult"
                                          Visibility="Collapsed"
                                          VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="20">
                                    <GroupBox Style="{StaticResource MaterialDesignCardGroupBox}">
                                        <GroupBox.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="Jsfiddle" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Resultado del Analisis" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </GroupBox.Header>

                                        <StackPanel Margin="10">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon Kind="CheckCircle" Foreground="#2ECC71" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                <TextBlock Text="Analisis Completado" Foreground="{DynamicResource MaterialDesignBody}" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <TextBlock Text="Revise y edite los campos generados antes de confirmar" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="12" Margin="0,5,0,0"/>
                                            <!-- Seccion 1: Stored Procedure -->
                                            <Expander IsExpanded="True" Margin="0,0,0,10" Style="{StaticResource MaterialDesignExpander}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="DatabaseSearch" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Stored Procedure" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Margin="15">
                                                    <TextBox x:Name="txtSPName" materialDesign:HintAssist.Hint="Nombre del SP" Margin="0,0,0,10" FontFamily="Consolas"/>
                                                    <TextBlock Text="Ejemplo: sp_buscar_productos, pr_listar_clientes" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,5"/>
                                                </StackPanel>
                                            </Expander>
                                            <!-- Seccion 2: Request (Parametros de entrada) -->
                                            <Expander IsExpanded="True" Margin="0,0,0,10" Style="{StaticResource MaterialDesignExpander}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Import" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Request - Parametros de Entrada" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Margin="15">
                                                    <TextBlock Text="Formato: tipo nombre (uno por linea)" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,5"/>
                                                    <TextBox x:Name="txtRequestParams" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" FontFamily="Consolas" FontSize="12" materialDesign:HintAssist.Hint="Ejemplo:&#x0a;int Codigo&#x0a;string Nombre&#x0a;DateTime? FechaInicio"/>
                                                </StackPanel>
                                            </Expander>
                                            <!-- Seccion 3: Parameters (Parametros de entrada) -->
                                            <Expander IsExpanded="True" Margin="0,0,0,10" Style="{StaticResource MaterialDesignExpander}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="CodeBraces" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Parseo Parametros de Entrada" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Margin="15">
                                                    <TextBlock Text="Formato: tipo nombre (uno por linea)" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,5"/>
                                                    <TextBox x:Name="txtParameters" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="120" FontFamily="Consolas" FontSize="12" materialDesign:HintAssist.Hint="Ejemplo:&#x0a;int Codigo&#x0a;string Nombre&#x0a;DateTime? FechaInicio"/>
                                                </StackPanel>
                                            </Expander>
                                            <!-- Seccion 4: DTO (Estructura de base de datos) -->
                                            <Expander IsExpanded="True" Margin="0,0,0,10" Style="{StaticResource MaterialDesignExpander}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Table" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="DTO - Campos del SP" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Margin="15">
                                                    <TextBlock Text="Campos que retorna la base de datos" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,5"/>
                                                    <TextBox x:Name="txtDTOFields" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="150" FontFamily="Consolas" FontSize="12" materialDesign:HintAssist.Hint="Ejemplo:&#x0a;int pro_codigo&#x0a;string pro_nombre&#x0a;decimal pro_precio"/>
                                                </StackPanel>
                                            </Expander>
                                            <!-- Seccion 4: Response Mapper -->
                                            <Expander IsExpanded="True" Margin="0,0,0,10" Style="{StaticResource MaterialDesignExpander}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Kind="Export" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock Text="Response - Mapeo de Salida" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                                    </StackPanel>
                                                </Expander.Header>
                                                <StackPanel Margin="15">
                                                    <TextBlock Text="Mapeo: campoDTO -> propiedadAPI (formato JSON)" FontSize="10" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="0,0,0,5"/>
                                                    <TextBox x:Name="txtResponseMapper" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="150" FontFamily="Consolas" FontSize="12" materialDesign:HintAssist.Hint="Ejemplo (objeto anonimo):&#x0a;codigo = dto.pro_codigo,&#x0a;nombre = dto.pro_nombre,&#x0a;precio = dto.pro_precio"/>
                                                </StackPanel>
                                            </Expander>
                                        </StackPanel>
                                    </GroupBox>

                                
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 🦶 FOOTER -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,15,0,0">
            <Button x:Name="btnCancelar"
                    Content="Cancelar"
                    Width="110"
                    Margin="0,0,10,0"
                    Click="btnCancelar_Click"
                    Style="{StaticResource MaterialDesignFlatButton}"/>
            <Button x:Name="btnVolverAnalizar" 
                    Click="btnBackToInput_Click" 
                    Style="{StaticResource MaterialDesignFlatButton}" 
                    Margin="0,0,10,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Undo" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Volver a Analizar" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <Button x:Name="btnCrear"
                    Content="Crear Metodo"
                    Width="140"
                    Click="btnCrear_Click"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
        </StackPanel>
    </Grid>
</Window>
