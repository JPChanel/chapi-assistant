                                                    <TextBox Text="{Binding Session.Metadata[APROB_FECHA], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Center"/>
                                                </Border>
                                            </Grid>
                                        </Border>


                                        <!-- ?? HISTORIAL DE VERSIONES -->
                                        <StackPanel Margin="0,0,0,40">
