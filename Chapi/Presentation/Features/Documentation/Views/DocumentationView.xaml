<UserControl x:Class="Chapi.Presentation.Features.Documentation.Views.DocumentationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wpf="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:doc="clr-namespace:Chapi.Domain.Documentation"
             xmlns:conv="clr-namespace:Chapi.Presentation.Converters"
             Background="{DynamicResource MaterialDesignPaper}">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:SectionTypeIconConverter x:Key="SectionTypeIconConverter"/>
        <conv:TemplateTitleConverter x:Key="TemplateTitleConverter"/>
        <conv:InverseBooleanConverter x:Key="InvBool"/>
        <conv:InverseBooleanToVisibilityConverter x:Key="InvBoolToVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVis"/>
        <conv:StringToVisibilityConverter x:Key="StringToVisInv" Inverse="True"/>
        <conv:JsonArrayToDictionaryListConverter x:Key="JsonArrayToDictionaryListConverter"/>

        <!-- ? Estilos Premium (React-inspired) -->
        <Style x:Key="WordPageStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
            <Setter Property="Margin" Value="0,32"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="64"/>
            <Setter Property="MaxWidth" Value="850"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextElement.FontFamily" Value="Cambria, Georgia, serif"/>
            <Setter Property="TextElement.FontSize" Value="13"/>
            <Setter Property="TextElement.Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Opacity="0.18" Color="Black"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DocTagStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHueLightBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontFamily" Value="Cambria, Georgia, serif"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextAlignment" Value="Justify"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="MinWidth" Value="80"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                <Setter Property="BorderThickness" Value="1.5"/>
                            </Trigger>
                            <DataTrigger Binding="{Binding DataContext.ShowTags, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBodyLight}"/>
                                <Setter Property="Opacity" Value="0.4"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="FontFamily" Value="Cambria, Georgia, serif"/>
        </Style>

        <Style x:Key="SectionNumberStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionHeaderStyle}">
            <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="BlockTagStyle" TargetType="TextBox" BasedOn="{StaticResource DocTagStyle}">
            <Setter Property="Background" Value="{DynamicResource StatusWarningMutedBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningSoftBorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontFamily" Value="Cascadia Code, Consolas, monospace"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="MinHeight" Value="22"/>
        </Style>

        <!-- ?? Estilos para Sub-secciones y Contenedores Específicos -->
        <Style x:Key="SubsectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="FontFamily" Value="Cambria, Georgia, serif"/>
            <Setter Property="Margin" Value="0,16,0,12"/>
        </Style>

        <Style x:Key="SummaryBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource StatusWarningSoftBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="DiagramBoxStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="24"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="LabelCellStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource MaterialDesignPaper}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="ValueCellStyle" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style x:Key="DynamicItemTextStyle" TargetType="TextBox" BasedOn="{StaticResource DocTagStyle}">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="MinWidth" Value="60"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <EventSetter Event="LostFocus" Handler="DynamicItemTextBox_LostFocus"/>
        </Style>

        <Style x:Key="DiagramCodeTextStyle" TargetType="TextBox" BasedOn="{StaticResource DocTagStyle}">
            <EventSetter Event="TextChanged" Handler="DiagramEditor_TextChanged"/>
        </Style>

        <Style x:Key="DynamicDiagramCodeTextStyle" TargetType="TextBox" BasedOn="{StaticResource DynamicItemTextStyle}">
            <EventSetter Event="TextChanged" Handler="DiagramEditor_TextChanged"/>
        </Style>

        <Style x:Key="KrokiModeButtonStyle" TargetType="ToggleButton">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="MinWidth" Value="82"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource MaterialDesignBody}"/>
            <Setter Property="Background" Value="{DynamicResource MaterialDesignCardBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource MaterialDesignDivider}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0">
                                <md:PackIcon x:Name="ModeIcon"
                                             Kind="CodeTags"
                                             Width="14"
                                             Height="14"
                                             Margin="0,0,6,0"
                                             Foreground="{TemplateBinding Foreground}"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="preview">
                                <Setter TargetName="ModeIcon" Property="Kind" Value="EyeOutline"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PrimaryHueLightBrush}"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AppPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type conv:KrokiSvgBrowser}">
            <Setter Property="ClipToBounds" Value="True"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>

    </UserControl.Resources>

    <!-- Layout raíz: Sidebar + Contenido principal -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ==- SIDEBAR OSCURO ================================================== -->
        <Border Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0">
            <DockPanel>

                <!-- Header del sidebar -->
                <Border DockPanel.Dock="Top" Background="{DynamicResource MaterialDesignCardBackground}" Padding="24,24,24,16" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal" >
                        <Border Background="{DynamicResource AppPrimaryBrush}" CornerRadius="8" Padding="8" Margin="0,0,12,0">
                            <md:PackIcon Kind="FileDocument" Foreground="{DynamicResource ActionTextOnAccentBrush}" Width="20" Height="20"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ChapiDocs" FontWeight="Black" FontSize="16" Foreground="{DynamicResource MaterialDesignBody}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Panel Inferior (Toggle + Botón Generar) -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource MaterialDesignCardBackground}" Padding="16,16,16,24" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <!-- Toggle Mostrar Etiquetas -->
                        <DockPanel Margin="8,0,8,16">
                            <TextBlock Text="Mostrar Etiquetas" Foreground="{DynamicResource MaterialDesignBodyLight}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                            <ToggleButton IsChecked="{Binding ShowTags}" HorizontalAlignment="Right" Cursor="Hand" BorderThickness="0" Background="Transparent" Padding="0" Width="40">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ToggleButton">
                                                    <Border x:Name="border" CornerRadius="10" Background="{DynamicResource MaterialDesignDivider}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Height="20">
                                                        <Ellipse x:Name="knob" Width="14" Height="14" Fill="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Left" Margin="2,0,0,0"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsChecked" Value="True">
                                                            <Setter TargetName="border" Property="Background" Value="{DynamicResource AppPrimaryBrush}"/>
                                                            <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                                            <Setter TargetName="knob" Property="Fill" Value="{DynamicResource ActionTextOnAccentBrush}"/>
                                                            <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                                            <Setter TargetName="knob" Property="Margin" Value="0,0,2,0"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                        </DockPanel>

                        <!-- Botón Guardar Ahora -->
                        <Button Command="{Binding SaveCommand}"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                md:ButtonAssist.CornerRadius="12"
                                Background="{DynamicResource AppPrimaryBrush}"
                                BorderBrush="{DynamicResource AppPrimaryBrush}"
                                Foreground="{DynamicResource ActionTextOnAccentBrush}"
                                Height="44" FontWeight="Bold"
                                Cursor="Hand"
                                Margin="0,0,0,10">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="ContentSaveEdit" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Guardar Ahora" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Botón Generar Word -->
                        <Button Command="{Binding ExportWordCommand}" 
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Background="{DynamicResource AppSecondaryBrush}" BorderBrush="{DynamicResource AppSecondaryBrush}"
                                md:ButtonAssist.CornerRadius="12"
                                Height="48" FontWeight="Bold" Foreground="{DynamicResource ActionTextOnSecondaryBrush}" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <md:PackIcon Kind="FileWordBox" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Generar Word" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <!-- PLANTILLAS -->
                <StackPanel DockPanel.Dock="Top" Margin="16,20,16,0">
                    <TextBlock Text="PLANTILLAS BASE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" Margin="4,0,0,12" FontFamily="Cascadia Code, Consolas"/>
                    <Grid Height="50">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Margin="0,0,4,0" Command="{Binding ApplyTemplateCommand}" CommandParameter="{x:Static doc:DocTemplate.ModeloSoftware}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="12" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <md:PackIcon Kind="BookOpenOutline" x:Name="Icon" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TemplateText" Text="Modelo Software" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding CurrentTemplate}" Value="{x:Static doc:DocTemplate.ModeloSoftware}">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppPrimaryBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource ActionTextOnAccentBrush}"/>
                                            <Setter TargetName="TemplateText" Property="Foreground" Value="{DynamicResource ActionTextOnAccentBrush}"/>
                                            <Setter TargetName="Bd" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#2563EB"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Grid.Column="1" Margin="4,0,0,0" Command="{Binding ApplyTemplateCommand}" CommandParameter="{x:Static doc:DocTemplate.DisenoSistema}" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{DynamicResource MaterialDesignCardBackground}" CornerRadius="12" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <md:PackIcon Kind="Drawing" x:Name="Icon" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center" Margin="0,0,0,2"/>
                                            <TextBlock x:Name="TemplateText" Text="Diseño Sistemas" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding CurrentTemplate}" Value="{x:Static doc:DocTemplate.DisenoSistema}">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AppPrimaryBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AppBorderBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource ActionTextOnAccentBrush}"/>
                                            <Setter TargetName="TemplateText" Property="Foreground" Value="{DynamicResource ActionTextOnAccentBrush}"/>
                                            <Setter TargetName="Bd" Property="Effect">
                                                <Setter.Value>
                                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3" Color="#2563EB"/>
                                                </Setter.Value>
                                            </Setter>
                                        </DataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                    <TextBlock Text="ESTRUCTURA DEL DOCUMENTO" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBodyLight}" FontFamily="Cascadia Code, Consolas"/>
                </StackPanel>

                <!-- ESTRUCTURA -->
            

                <!-- Lista de secciones -->
                <ListBox ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}" Background="Transparent" BorderThickness="0" Margin="12,0">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,2"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10" Padding="12,10">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MaterialDesignSelection}"/>
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <md:PackIcon Kind="{Binding Type, Converter={StaticResource SectionTypeIconConverter}}" Foreground="{DynamicResource MaterialDesignBodyLight}" Width="14" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{DynamicResource MaterialDesignBody}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="2" Command="{Binding DataContext.RemoveSectionCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}" Style="{StaticResource MaterialDesignIconButton}" Width="20" Height="20" Padding="0" Foreground="{DynamicResource MaterialDesignBodyLight}">
                                    <md:PackIcon Kind="Close" Width="12"/>
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

            </DockPanel>
        </Border>

        <!-- ==- ÁREA PRINCIPAL: Hoja A4 + Editor + Consola AI ==================- -->
        <Grid Grid.Column="1" Background="{DynamicResource MaterialDesignPaper}" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Fondo gris con la "hoja" A4 centrada -->
            <ScrollViewer Grid.Row="0"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          ClipToBounds="True"
                          PanningMode="Both">
                <Grid Margin="10,40,10,120">

                    <!-- Hoja A4 blanca -->
                    <Border Style="{StaticResource WordPageStyle}">
                        <Grid>
                                <StackPanel>
                                    <!-- ?? ENCABEZADO PREMIUM (TIPO WORD) ================================ -->
                                    <StackPanel Margin="0,0,0,48">
                                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1.5" Padding="0,12" Margin="0,0,0,24">
                                            <TextBlock Text="{Binding CurrentTemplate, Converter={StaticResource TemplateTitleConverter}}" 
                                                       FontSize="22" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" 
                                                       TextAlignment="Center" HorizontalAlignment="Center"
                                                       FontFamily="Cambria, Georgia, serif" />
                                        </Border>
                                        
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,12">
                                            <TextBox Text="{Binding Session.Metadata[PROYECTO_CODIGO], Mode=TwoWay}" Style="{StaticResource DocTagStyle}"/>
                                            <TextBlock Text=" : " FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}" VerticalAlignment="Center" FontSize="16" Margin="8,0"/>
                                            <TextBox Text="{Binding Session.Metadata[PROYECTO_NOMBRE], Mode=TwoWay}" Style="{StaticResource DocTagStyle}"/>
                                        </StackPanel>
                                        
                                        <TextBox Text="{Binding Session.Metadata[DOC_MES_ANIO], Mode=TwoWay}" 
                                                 Style="{StaticResource DocTagStyle}" 
                                                 HorizontalAlignment="Center" 
                                                 FontSize="11" FontWeight="Bold" Margin="0,0,0,32"/>
                                    </StackPanel>

                                        <!-- ?? TABLA DE FIRMAS -->
                                        <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Margin="0,0,0,40">
                                            <Grid Background="{DynamicResource MaterialDesignPaper}">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="48"/>
                                                    <RowDefinition Height="48"/>
                                                    <RowDefinition Height="48"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="2*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Headers -->
                                                <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="12,10"><TextBlock Text="Nombres y Apellidos / Cargo" FontWeight="Bold" FontSize="12" FontFamily="Cambria"/></Border>
                                                <Border Grid.Row="0" Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="12,10"><TextBlock Text="Firma" FontWeight="Bold" FontSize="12" FontFamily="Cambria" HorizontalAlignment="Center"/></Border>
                                                <Border Grid.Row="0" Grid.Column="2" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="12,10"><TextBlock Text="Fecha" FontWeight="Bold" FontSize="12" FontFamily="Cambria" HorizontalAlignment="Center"/></Border>

                                                <!-- Elaborado -->
                                                <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="12,10">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Elaborado por: " FontStyle="Italic" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,8,0"/>
                                                        <TextBox Text="{Binding Session.Metadata[ELAB_NOM], Mode=TwoWay}" Style="{StaticResource DocTagStyle}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1"/>
                                                <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8">
                                                    <TextBox Text="{Binding Session.Metadata[ELAB_FECHA], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Center"/>
                                                </Border>

                                                <!-- Revisado -->
                                                <Border Grid.Row="2" Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="12,10">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="Revisado por: " FontStyle="Italic" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,8,0"/>
