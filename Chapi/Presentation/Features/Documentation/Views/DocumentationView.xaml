                                                              IsChecked="{Binding ShowKrokiCode, Mode=TwoWay, Converter={StaticResource InvBool}}"
                                                              Style="{StaticResource KrokiModeButtonStyle}"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                            <md:PackIcon Kind="ImageOutline" Foreground="{DynamicResource PrimaryHueMidBrush}" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Session.Metadata[IMG_CLASES_SISTEMA], Mode=TwoWay}"
                                                     Style="{StaticResource DiagramCodeTextStyle}" HorizontalAlignment="Left"
                                                     Visibility="{Binding ShowKrokiCode, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Border Visibility="{Binding ShowKrokiCode, Converter={StaticResource InvBoolToVis}}"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="6" Padding="8" Background="{DynamicResource MaterialDesignPaper}" Margin="0,0,0,6">
                                            <conv:KrokiSvgBrowser DiagramCode="{Binding Session.Metadata[IMG_CLASES_SISTEMA]}" Height="260" HorizontalAlignment="Stretch"/>
                                        </Border>
                                        <TextBlock Text="Diagrama de clases del sistema" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- 6.2 Especificación de clases -->
                                <TextBlock Text="6.2  Especificación de clases" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" FontFamily="Cambria" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding Session.Metadata[BLOQUE_CLASE_DET_INICIO], Mode=TwoWay}"
                                         Style="{StaticResource BlockTagStyle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Margin="0,0,0,16" Padding="16"
                                        Visibility="{Binding Session.Metadata[BLOQUE_CLASE_DET_ITEMS], Converter={StaticResource StringToVisInv}}">
                                    <StackPanel>
                                        <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="12,8" Margin="0,0,0,12">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Clase: " FontSize="15" FontWeight="Bold"/>
                                                <TextBox Text="{Binding Session.Metadata[CLASE_TITULO], Mode=TwoWay}"
                                                         Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelCellStyle}"><TextBlock Text="Atributos" FontWeight="Bold" FontSize="11"/></Border>
                                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueCellStyle}">
                                                <TextBox Text="{Binding Session.Metadata[CLASE_ATRIB], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelCellStyle}"><TextBlock Text="Operaciones" FontWeight="Bold" FontSize="11"/></Border>
                                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueCellStyle}">
                                                <TextBox Text="{Binding Session.Metadata[CLASE_OPER], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left"/>
                                            </Border>
                                            <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelCellStyle}"><TextBlock Text="Agregación" FontWeight="Bold" FontSize="11"/></Border>
                                            <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueCellStyle}">
                                                <TextBox Text="{Binding Session.Metadata[CLASE_AGREG], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left"/>
                                            </Border>
                                            <Border Grid.Row="3" Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0" Padding="12,10" Background="{DynamicResource MaterialDesignPaper}"><TextBlock Text="Asociación" FontWeight="Bold" FontSize="11"/></Border>
                                            <Border Grid.Row="3" Grid.Column="1" Padding="12,10">
                                                <TextBox Text="{Binding Session.Metadata[CLASE_ASOC], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left"/>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <ItemsControl Visibility="{Binding Session.Metadata[BLOQUE_CLASE_DET_ITEMS], Converter={StaticResource StringToVis}}"
                                              ItemsSource="{Binding Session.Metadata[BLOQUE_CLASE_DET_ITEMS], Converter={StaticResource JsonArrayToDictionaryListConverter}}"
                                              Tag="BLOQUE_CLASE_DET_ITEMS">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Margin="0,0,0,16" Padding="16">
                                                <StackPanel>
                                                    <Border Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="12,8" Margin="0,0,0,12">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Clase: " FontSize="15" FontWeight="Bold"/>
                                                            <TextBox Text="{Binding [CLASE_TITULO], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DynamicItemTextStyle}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="160"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelCellStyle}"><TextBlock Text="Atributos" FontWeight="Bold" FontSize="11"/></Border>
                                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueCellStyle}"><TextBox Text="{Binding [CLASE_ATRIB], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DynamicItemTextStyle}" Margin="2"/></Border>
                                                        <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource LabelCellStyle}"><TextBlock Text="Operaciones" FontWeight="Bold" FontSize="11"/></Border>
                                                        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource ValueCellStyle}"><TextBox Text="{Binding [CLASE_OPER], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DynamicItemTextStyle}" Margin="2"/></Border>
                                                        <Border Grid.Row="2" Grid.Column="0" Style="{StaticResource LabelCellStyle}"><TextBlock Text="Agregación" FontWeight="Bold" FontSize="11"/></Border>
                                                        <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource ValueCellStyle}"><TextBox Text="{Binding [CLASE_AGREG], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DynamicItemTextStyle}" Margin="2"/></Border>
                                                        <Border Grid.Row="3" Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0" Padding="12,10" Background="{DynamicResource MaterialDesignPaper}"><TextBlock Text="Asociación" FontWeight="Bold" FontSize="11"/></Border>
                                                        <Border Grid.Row="3" Grid.Column="1" Padding="12,10"><TextBox Text="{Binding [CLASE_ASOC], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DynamicItemTextStyle}" Margin="2"/></Border>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Text="{Binding Session.Metadata[BLOQUE_CLASE_DET_FIN], Mode=TwoWay}"
                                         Style="{StaticResource BlockTagStyle}" HorizontalAlignment="Left" Margin="0,0,0,32"/>

                                <!-- == SECCIÓN 7: DIAGRAMA ENTIDAD-RELACIÓN ========================- -->
                                <StackPanel Margin="0,8,0,16">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="7. " Style="{StaticResource SectionNumberStyle}"/>
                                        <TextBlock Text="DIAGRAMA ENTIDAD - RELACIÓN" Style="{StaticResource SectionHeaderStyle}"/>
                                    </StackPanel>
                                    <Border Height="2" Background="{DynamicResource MaterialDesignDivider}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Background="{DynamicResource MaterialDesignPaper}" MinHeight="200" Margin="0,0,0,32">
                                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="24">
                                        <Border HorizontalAlignment="Center" Margin="0,0,0,8" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="16" Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton Content="Código"
                                                              Tag="code"
                                                              IsChecked="{Binding ShowKrokiCode, Mode=TwoWay}"
                                                              Style="{StaticResource KrokiModeButtonStyle}" Margin="0,0,4,0"/>
                                                <ToggleButton Content="Vista previa"
                                                              Tag="preview"
                                                              IsChecked="{Binding ShowKrokiCode, Mode=TwoWay, Converter={StaticResource InvBool}}"
                                                              Style="{StaticResource KrokiModeButtonStyle}"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                            <md:PackIcon Kind="ImageOutline" Foreground="{DynamicResource PrimaryHueMidBrush}" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Session.Metadata[IMG_DER], Mode=TwoWay}"
                                                     Style="{StaticResource DiagramCodeTextStyle}" HorizontalAlignment="Left"
                                                     Visibility="{Binding ShowKrokiCode, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Border Visibility="{Binding ShowKrokiCode, Converter={StaticResource InvBoolToVis}}"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="6" Padding="8" Background="{DynamicResource MaterialDesignPaper}" Margin="0,0,0,6">
                                            <conv:KrokiSvgBrowser DiagramCode="{Binding Session.Metadata[IMG_DER]}" Height="260" HorizontalAlignment="Stretch"/>
                                        </Border>
                                        <TextBlock Text="Diagrama Entidad-Relación" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- == SECCIÓN 8: DICCIONARIO DE DATOS ============================- -->
                                <StackPanel Margin="0,8,0,16">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="8. " Style="{StaticResource SectionNumberStyle}"/>
                                        <TextBlock Text="DICCIONARIO DE DATOS" Style="{StaticResource SectionHeaderStyle}"/>
                                    </StackPanel>
                                    <Border Height="2" Background="{DynamicResource MaterialDesignDivider}" HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <!-- 8.1 Listado de tablas -->
                                <TextBlock Text="8.1  Listado de tablas" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" FontFamily="Cambria" Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource StatusWarningMutedBackgroundBrush}" BorderBrush="{DynamicResource StatusWarningSoftBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,16">
                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <md:PackIcon Kind="TableLarge" Foreground="{DynamicResource StatusWarningBrush}" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Session.Metadata[TABLA_DICC_RESUMEN], Mode=TwoWay}"
                                                     Style="{StaticResource BlockTagStyle}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- 8.2 Descripción de tablas -->
                                <TextBlock Text="8.2  Descripción de tablas" FontSize="13" FontWeight="Bold" FontStyle="Italic" Foreground="{DynamicResource MaterialDesignBody}" FontFamily="Cambria" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding Session.Metadata[BLOQUE_DICC_TABLA_INICIO], Mode=TwoWay}"
                                         Style="{StaticResource BlockTagStyle}" HorizontalAlignment="Left" Margin="0,0,0,8"/>
                                <TextBox Text="{Binding Session.Metadata[BLOQUE_DICC_TABLA_ITEMS], Mode=TwoWay}"
                                         Style="{StaticResource DocTagStyle}" HorizontalAlignment="Stretch" Margin="0,0,0,8"/>

                                <!-- Fallback legacy (1 tabla) cuando no existe JSON dinámico -->
                                <StackPanel Margin="0,0,0,16"
                                            Visibility="{Binding Session.Metadata[BLOQUE_DICC_TABLA_ITEMS], Converter={StaticResource StringToVisInv}}">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <TextBlock Text="Tabla X: " FontSize="13" FontWeight="Bold" FontFamily="Cambria" Foreground="{DynamicResource MaterialDesignBody}"/>
                                        <TextBox Text="{Binding Session.Metadata[DICC_TABLA_TITULO], Mode=TwoWay}"
                                                 Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                                        <Grid Background="{DynamicResource MaterialDesignPaper}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="50"/>
                                                <ColumnDefinition Width="2*"/>
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="8,6"><TextBlock Text="CAMPO" FontWeight="Bold" FontSize="9"/></Border>
                                            <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="8,6"><TextBlock Text="TIPO DE DATO" FontWeight="Bold" FontSize="9"/></Border>
                                            <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="8,6"><TextBlock Text="PK" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/></Border>
                                            <Border Grid.Row="0" Grid.Column="3" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,6"><TextBlock Text="DESCRIPCIÓN" FontWeight="Bold" FontSize="9"/></Border>
                                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Background="{DynamicResource PrimaryHueLightBrush}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,4">
                                                <TextBox Text="{Binding Session.Metadata[BLOQUE_COL_INICIO], Mode=TwoWay}" Style="{StaticResource BlockTagStyle}" HorizontalAlignment="Center" Margin="0"/>
                                            </Border>
                                            <Border Grid.Row="2" Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBox Text="{Binding Session.Metadata[COL_NOM], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left" FontWeight="Bold"/>
                                            </Border>
                                            <Border Grid.Row="2" Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBox Text="{Binding Session.Metadata[COL_TIPO], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left"/>
                                            </Border>
                                            <Border Grid.Row="2" Grid.Column="2" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="8,6">
                                                <TextBox Text="{Binding Session.Metadata[COL_PK], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Center"/>
                                            </Border>
                                            <Border Grid.Row="2" Grid.Column="3" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,6">
                                                <TextBox Text="{Binding Session.Metadata[COL_DESC], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left"/>
                                            </Border>
                                            <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4" Background="{DynamicResource PrimaryHueLightBrush}" Padding="8,4">
                                                <TextBox Text="{Binding Session.Metadata[BLOQUE_COL_FIN], Mode=TwoWay}" Style="{StaticResource BlockTagStyle}" HorizontalAlignment="Center" Margin="0"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- Render dinámico: múltiples tablas desde BLOQUE_DICC_TABLA_ITEMS -->
                                <ItemsControl ItemsSource="{Binding Session.Metadata[BLOQUE_DICC_TABLA_ITEMS], Converter={StaticResource JsonArrayToDictionaryListConverter}}"
                                              Margin="0,0,0,16"
                                              Visibility="{Binding Session.Metadata[BLOQUE_DICC_TABLA_ITEMS], Converter={StaticResource StringToVis}}"
                                              Tag="BLOQUE_DICC_TABLA_ITEMS">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,12">
                                                <TextBox Text="{Binding [DICC_TABLA_TITULO], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         Style="{StaticResource DynamicItemTextStyle}"
                                                         FontSize="13" FontWeight="Bold" FontFamily="Cambria" Foreground="{DynamicResource MaterialDesignBody}" Margin="0,0,0,6"/>
                                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                                                    <Grid Background="{DynamicResource MaterialDesignPaper}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="120"/>
                                                            <ColumnDefinition Width="50"/>
                                                            <ColumnDefinition Width="2*"/>
                                                        </Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>
                                                        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="8,6"><TextBlock Text="CAMPO" FontWeight="Bold" FontSize="9"/></Border>
                                                        <Border Grid.Row="0" Grid.Column="1" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="8,6"><TextBlock Text="TIPO DE DATO" FontWeight="Bold" FontSize="9"/></Border>
                                                        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="8,6"><TextBlock Text="PK" FontWeight="Bold" FontSize="9" HorizontalAlignment="Center"/></Border>
                                                        <Border Grid.Row="0" Grid.Column="3" Background="{DynamicResource MaterialDesignCardBackground}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="8,6"><TextBlock Text="DESCRIPCIÓN" FontWeight="Bold" FontSize="9"/></Border>
                                                        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0" Padding="8,6"><TextBox Text="{Binding [COL_NOM], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DynamicItemTextStyle}" FontSize="11"/></Border>
                                                        <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0" Padding="8,6"><TextBox Text="{Binding [COL_TIPO], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DynamicItemTextStyle}" FontSize="11"/></Border>
                                                        <Border Grid.Row="1" Grid.Column="2" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0" Padding="8,6"><TextBox Text="{Binding [COL_PK], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DynamicItemTextStyle}" FontSize="11" HorizontalAlignment="Center"/></Border>
                                                        <Border Grid.Row="1" Grid.Column="3" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,0" Padding="8,6"><TextBox Text="{Binding [COL_DESC], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DynamicItemTextStyle}" FontSize="11"/></Border>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBox Text="{Binding Session.Metadata[BLOQUE_DICC_TABLA_FIN], Mode=TwoWay}"
                                         Style="{StaticResource BlockTagStyle}" HorizontalAlignment="Left" Margin="0,0,0,24"/>

                                <!-- 8.3-8.7 Listados de objetos DB -->
                                <Border Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Margin="0,0,0,4" Padding="12,8">
                                    <Grid>
                                        <TextBlock Text="8.3  Listado de paquetes" FontWeight="Bold" FontSize="12" FontFamily="Cambria" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Session.Metadata[TABLA_OBJ_PQ], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Margin="0,0,0,4" Padding="12,8">
                                    <Grid>
                                        <TextBlock Text="8.4  Listado de procedimientos" FontWeight="Bold" FontSize="12" FontFamily="Cambria" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Session.Metadata[TABLA_OBJ_PROC], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Margin="0,0,0,4" Padding="12,8">
                                    <Grid>
                                        <TextBlock Text="8.5  Listado de vistas" FontWeight="Bold" FontSize="12" FontFamily="Cambria" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Session.Metadata[TABLA_OBJ_VISTAS], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Margin="0,0,0,4" Padding="12,8">
                                    <Grid>
                                        <TextBlock Text="8.6  Listado de funciones" FontWeight="Bold" FontSize="12" FontFamily="Cambria" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Session.Metadata[TABLA_OBJ_FUNC], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>
                                <Border Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Margin="0,0,0,32" Padding="12,8">
                                    <Grid>
                                        <TextBlock Text="8.7  Listado de índices" FontWeight="Bold" FontSize="12" FontFamily="Cambria" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding Session.Metadata[TABLA_OBJ_IDX], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                </StackPanel>
                                <!-- == FIN BODY: DISEÑO DEL SISTEMA ============================== -->


                                    <!-- Footer del documento (Word Style) -->
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,40,0,0">
                                        <Grid>
                                            <TextBlock Text="Chapi Assistant — Ingeniería de Software" FontSize="9" Foreground="{DynamicResource MaterialDesignBodyLight}" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" HorizontalAlignment="Left"/>
                                            <TextBlock Text="Página 1 de n" FontSize="9" Foreground="{DynamicResource MaterialDesignBodyLight}" FontFamily="Cascadia Code, Consolas" FontWeight="Bold" HorizontalAlignment="Right"/>
                                        </Grid>
                                    </Border>

                                </StackPanel>
                        </Grid>
                    </Border>

                    <!-- WebView2 flotante para preview de diagramas (oculto por defecto) -->
                    <wpf:WebView2 x:Name="PreviewWebView"
                                  Visibility="Collapsed"
                                  Width="0" Height="0"/>
                </Grid>
            </ScrollViewer>

            <!-- == CONSOLA AI FLOTANTE (dock al fondo) ========================- -->
            <Border Grid.Row="1"
                    Background="{DynamicResource MaterialDesignPaper}"
                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                    BorderThickness="0,1,0,0"
                    Padding="12,12">
                <Border Background="{DynamicResource MaterialDesignCardBackground}"
                        BorderBrush="{DynamicResource MaterialDesignDivider}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="12,10">
                    <Grid HorizontalAlignment="Stretch">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource AppPrimaryBrush}"
                                CornerRadius="8"
                                Padding="8,4"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="AI"
                                       Foreground="{DynamicResource ActionTextOnAccentBrush}"
                                       FontSize="13"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Background="{DynamicResource MaterialDesignPaper}"
                                    BorderBrush="{DynamicResource MaterialDesignDivider}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="8,2"
                                    Visibility="{Binding IsGenerating, Converter={StaticResource InvBoolToVis}}">
                                <TextBox x:Name="AiPromptBox"
                                         Text="{Binding AiPrompt, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Foreground="{DynamicResource MaterialDesignBody}"
                                         FontSize="13"
                                         FontWeight="Medium"
                                         VerticalContentAlignment="Center"
                                         md:HintAssist.Hint="Escribe qué sección quieres generar o editar..."
                                         md:HintAssist.Foreground="{DynamicResource MaterialDesignBodyLight}"
                                         md:HintAssist.HelperTextFontSize="12"
                                         CaretBrush="{DynamicResource MaterialDesignBody}"
                                         KeyDown="AiPromptBox_KeyDown"/>
                            </Border>

                            <TextBlock Grid.Row="1"
                                       Text="{Binding StatusMessage}"
                                       Foreground="{DynamicResource StatusInfoBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Margin="2,6,0,0"
                                       FontStyle="Italic"
                                       Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>

                        <!-- Checkbox Generar Todo -->
                        <CheckBox Grid.Column="2"
                                  Content="Generar Todo"
                                  IsChecked="{Binding GenerateAll}"
                                  Foreground="{DynamicResource MaterialDesignBodyLight}"
                                  FontSize="11"
                                  FontWeight="SemiBold"
                                  VerticalAlignment="Center"
                                  Margin="12,0,14,0"/>

                        <!-- Sección seleccionada -->
                        <Border Grid.Column="3"
                                Background="{DynamicResource MaterialDesignPaper}"
                                BorderBrush="{DynamicResource AppBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10,4"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding GenerateAll, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="{Binding SelectedSection.Title, StringFormat='-> {0}', FallbackValue='-> sin sección'}"
                                       Foreground="{DynamicResource AppPrimaryBrush}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       FontFamily="Cascadia Code, Consolas, monospace"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="170"/>
                        </Border>

                        <Button Grid.Column="4"
                                x:Name="AiGenerateButton"
                                Click="AiGenerateButton_Click"
                                BorderThickness="1"
                                md:ButtonAssist.CornerRadius="10"
                                Padding="20,0"
                                Height="40"
                                FontWeight="Bold"
                                FontSize="12"
                                Cursor="Hand">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignRaisedButton}">
                                    <Setter Property="Background" Value="{DynamicResource AppPrimaryBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource ActionTextOnAccentBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource AppPrimaryBrush}"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AppSecondaryBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AppSecondaryBrush}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource ActionTextOnSecondaryBrush}"/>
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsGenerating}" Value="True">
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Grid>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsGenerating, Converter={StaticResource InvBoolToVis}}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <md:PackIcon Kind="RobotExcitedOutline"
                                                 Width="18"
                                                 Height="18"
                                                 Margin="0,0,8,0"
                                                 VerticalAlignment="Center"
                                                 Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                                    <TextBlock Text="Iniciar Análisis AI"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding IsGenerating, Converter={StaticResource BoolToVis}}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                                 Value="0"
                                                 IsIndeterminate="True"
                                                 Width="16"
                                                 Height="16"
                                                 Foreground="{DynamicResource ActionTextOnAccentBrush}"
                                                 Margin="0,0,8,0"/>
                                    <TextBlock Text="Analizando..." VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Button>
                    </Grid>
                </Border>
            </Border>
        </Grid>
    </Grid>
</UserControl>







