                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                                        <Grid Background="{DynamicResource MaterialDesignPaper}">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelCellStyle}"><TextBlock Text="Descripción" FontWeight="Bold" FontSize="11"/></Border>
                                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueCellStyle}">
                                                <TextBox Text="{Binding Session.Metadata[PQ_DESC], Mode=TwoWay}"
                                                         Style="{StaticResource DocTagStyle}"
                                                         HorizontalAlignment="Stretch"
                                                         TextWrapping="Wrap"
                                                         AcceptsReturn="True"
                                                         VerticalScrollBarVisibility="Auto"
                                                         HorizontalScrollBarVisibility="Disabled"
                                                         MinHeight="44"/>
                                            </Border>
                                            <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0" Padding="12,10" Background="{DynamicResource MaterialDesignPaper}"><TextBlock Text="Clases" FontWeight="Bold" FontSize="11"/></Border>
                                            <Border Grid.Row="1" Grid.Column="1" Padding="12,10">
                                                <TextBox Text="{Binding Session.Metadata[PQ_CLASES_LISTA], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <!-- 4.3.X Bloque dinámico de paquetes -->
                                <ItemsControl Visibility="{Binding Session.Metadata[BLOQUE_PQ_ITEMS], Converter={StaticResource StringToVis}}"
                                              ItemsSource="{Binding Session.Metadata[BLOQUE_PQ_ITEMS], Converter={StaticResource JsonArrayToDictionaryListConverter}}"
                                              Tag="BLOQUE_PQ_ITEMS">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="16,0,0,16">
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                                    <TextBlock Text="4.3.X " FontSize="12" FontWeight="Bold" FontFamily="Cambria" Foreground="{DynamicResource MaterialDesignBody}"/>
                                                    <TextBox Text="{Binding [PQ_ID_NOM], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DynamicItemTextStyle}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource PrimaryHueMidBrush}"/>
                                                </StackPanel>
                                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1">
                                                    <Grid Background="{DynamicResource MaterialDesignPaper}">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="180"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                        <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource LabelCellStyle}"><TextBlock Text="Descripción" FontWeight="Bold" FontSize="11"/></Border>
                                                        <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource ValueCellStyle}">
                                                            <TextBox Text="{Binding [PQ_DESC], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DynamicItemTextStyle}" TextAlignment="Justify"/>
                                                        </Border>
                                                        <Border Grid.Row="1" Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0" Padding="12,10" Background="{DynamicResource MaterialDesignPaper}"><TextBlock Text="Clases" FontWeight="Bold" FontSize="11"/></Border>
                                                        <Border Grid.Row="1" Grid.Column="1" Padding="12,10">
                                                            <TextBox Text="{Binding [PQ_CLASES_LISTA], Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DynamicItemTextStyle}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBox Text="{Binding Session.Metadata[BLOQUE_PQ_FIN], Mode=TwoWay}"
                                         Style="{StaticResource BlockTagStyle}" HorizontalAlignment="Left" Margin="0,0,0,32"/>

                                <!-- == SECCIÓN 5: DIAGRAMA DE ACTORES ============================== -->
                                <StackPanel Margin="0,8,0,16">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="5. " Style="{StaticResource SectionNumberStyle}"/>
                                        <TextBlock Text="DIAGRAMA DE ACTORES" Style="{StaticResource SectionHeaderStyle}"/>
                                    </StackPanel>
                                    <Border Height="2" Background="{DynamicResource MaterialDesignDivider}" HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <!-- 5.1 Listado de actores -->
                                <TextBlock Text="5.1  Listado de actores" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" FontFamily="Cambria" Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource StatusWarningMutedBackgroundBrush}" BorderBrush="{DynamicResource StatusWarningSoftBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,16">
                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <md:PackIcon Kind="TableLarge" Foreground="{DynamicResource StatusWarningBrush}" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Session.Metadata[TABLA_ACTORES_LISTA], Mode=TwoWay}"
                                                     Style="{StaticResource BlockTagStyle}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <TextBlock Text="Principales / Secundarios" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource StatusWarningBrush}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- 5.2 Diagrama de actores -->
                                <TextBlock Text="5.2  Diagrama de actores" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" FontFamily="Cambria" Margin="0,0,0,8"/>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Background="{DynamicResource MaterialDesignPaper}" MinHeight="180" Margin="0,0,0,32">
                                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="24">
                                        <Border HorizontalAlignment="Center" Margin="0,0,0,8" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="16" Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton Content="Código"
                                                              Tag="code"
                                                              IsChecked="{Binding ShowKrokiCode, Mode=TwoWay}"
                                                              Style="{StaticResource KrokiModeButtonStyle}" Margin="0,0,4,0"/>
                                                <ToggleButton Content="Vista previa"
                                                              Tag="preview"
                                                              IsChecked="{Binding ShowKrokiCode, Mode=TwoWay, Converter={StaticResource InvBool}}"
                                                              Style="{StaticResource KrokiModeButtonStyle}"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                            <md:PackIcon Kind="ImageOutline" Foreground="{DynamicResource PrimaryHueMidBrush}" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Session.Metadata[IMG_ACTORES], Mode=TwoWay}"
                                                     Style="{StaticResource DiagramCodeTextStyle}" HorizontalAlignment="Left"
                                                     Visibility="{Binding ShowKrokiCode, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Border Visibility="{Binding ShowKrokiCode, Converter={StaticResource InvBoolToVis}}"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="6" Padding="8" Background="{DynamicResource MaterialDesignPaper}" Margin="0,0,0,6">
                                            <conv:KrokiSvgBrowser DiagramCode="{Binding Session.Metadata[IMG_ACTORES]}" Height="260" HorizontalAlignment="Stretch"/>
                                        </Border>
                                        <TextBlock Text="Diagrama de actores del sistema" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- == SECCIÓN 6: DIAGRAMA DE CASOS DE USO ========================- -->
                                <StackPanel Margin="0,8,0,16">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="6. " Style="{StaticResource SectionNumberStyle}"/>
                                        <TextBlock Text="DIAGRAMA DE CASOS DE USO" Style="{StaticResource SectionHeaderStyle}"/>
                                    </StackPanel>
                                    <Border Height="2" Background="{DynamicResource MaterialDesignDivider}" HorizontalAlignment="Stretch"/>
                                </StackPanel>

                                <!-- 6.1 Listado de Casos de Uso -->
                                <TextBlock Text="6.1  Listado de Casos de Uso" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" FontFamily="Cambria" Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource StatusWarningMutedBackgroundBrush}" BorderBrush="{DynamicResource StatusWarningSoftBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,16">
                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <md:PackIcon Kind="TableLarge" Foreground="{DynamicResource StatusWarningBrush}" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Session.Metadata[TABLA_CU_LISTADO], Mode=TwoWay}"
                                                     Style="{StaticResource BlockTagStyle}" HorizontalAlignment="Left"/>
                                        </StackPanel>
