                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.2*"/><ColumnDefinition Width="0.6*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.5*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.2*"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Headers -->
                                                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="4"><TextBlock Text="Fecha de Elaboración" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontFamily="Cambria"/></Border>
                                                    <Border Grid.Row="0" Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="4"><TextBlock Text="Versión" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Cambria"/></Border>
                                                    <Border Grid.Row="0" Grid.Column="2" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="4"><TextBlock Text="Elaborado por" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Cambria"/></Border>
                                                    <Border Grid.Row="0" Grid.Column="3" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="4"><TextBlock Text="Descripción" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Cambria"/></Border>
                                                    <Border Grid.Row="0" Grid.Column="4" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="4"><TextBlock Text="Revisado por" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" FontFamily="Cambria"/></Border>
                                                    <Border Grid.Row="0" Grid.Column="5" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="4"><TextBlock Text="Fecha de Revisión" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontFamily="Cambria"/></Border>

                                                    <!-- Block Tags -->
                                                    <Border Grid.Row="1" Grid.ColumnSpan="6" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Background="{DynamicResource StatusInfoMutedBackgroundBrush}" Padding="4">
                                                        <TextBox Text="[BLOQUE_HISTORIAL_INICIO]" Style="{StaticResource BlockTagStyle}" FontSize="9"/>
                                                    </Border>
                                                    
                                                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="4"><TextBox Text="{Binding Session.Metadata[HIST_FECHA_ELAB], Mode=TwoWay}" Style="{StaticResource DocTagStyle}"/></Border>
                                                    <Border Grid.Row="2" Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="4"><TextBox Text="{Binding Session.Metadata[HIST_VER], Mode=TwoWay}" Style="{StaticResource DocTagStyle}"/></Border>
                                                    <Border Grid.Row="2" Grid.Column="2" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="4"><TextBox Text="{Binding Session.Metadata[HIST_ELAB], Mode=TwoWay}" Style="{StaticResource DocTagStyle}"/></Border>
                                                    <Border Grid.Row="2" Grid.Column="3" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="4"><TextBox Text="{Binding Session.Metadata[HIST_DESC], Mode=TwoWay}" Style="{StaticResource DocTagStyle}"/></Border>
                                                    <Border Grid.Row="2" Grid.Column="4" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="4"><TextBox Text="{Binding Session.Metadata[HIST_REV], Mode=TwoWay}" Style="{StaticResource DocTagStyle}"/></Border>
                                                    <Border Grid.Row="2" Grid.Column="5" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="4"><TextBox Text="{Binding Session.Metadata[HIST_FECHA_REV], Mode=TwoWay}" Style="{StaticResource DocTagStyle}"/></Border>

                                                    <Border Grid.Row="3" Grid.ColumnSpan="6" Background="{DynamicResource StatusInfoMutedBackgroundBrush}" Padding="4">
                                                        <TextBox Text="[BLOQUE_HISTORIAL_FIN]" Style="{StaticResource BlockTagStyle}" FontSize="9"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </StackPanel>


                                    <!-- ?? TABLA DE REFERENCIA -->
                                    <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Margin="0,0,0,64">
                                        <StackPanel Background="{DynamicResource MaterialDesignPaper}">
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="12,10"><TextBlock Text="Código" FontSize="11" FontWeight="Bold" FontFamily="Cambria"/></Border>
                                                <Border Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="12,10">
                                                    <TextBox Text="{Binding Session.Metadata[REF_CODIGO], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left"/>
                                                </Border>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,1" Padding="12,10"><TextBlock Text="Sistema / Módulo / Aplicación" FontSize="11" FontWeight="Bold" FontFamily="Cambria"/></Border>
                                                <Border Grid.Column="1" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,0,1" Padding="12,10">
                                                    <TextBox Text="{Binding Session.Metadata[REF_SISTEMA], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left"/>
                                                </Border>
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="0,0,1,0" Padding="12,10"><TextBlock Text="Documento(s) asociado(s)" FontSize="11" FontWeight="Bold" FontFamily="Cambria"/></Border>
                                                <Border Grid.Column="1" Padding="12,10">
                                                    <TextBox Text="{Binding Session.Metadata[REF_DOCS], Mode=TwoWay}" Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left"/>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Border>


                                <!-- Secciones del documento específicas -->
                                <!-- ======- BODY: MODELO DE SOFTWARE ==============================- -->
                                <StackPanel Visibility="{Binding IsModeloSoftware, Converter={StaticResource BoolToVis}}">

                                    <!-- == SECCIÓN 1: INTRODUCCIÓN ==================================== -->
                                    <StackPanel Margin="0,32,0,16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="1. " Style="{StaticResource SectionNumberStyle}"/>
                                            <TextBlock Text="INTRODUCCIÓN" Style="{StaticResource SectionHeaderStyle}"/>
                                        </StackPanel>
                                        <Border Height="2" Background="{DynamicResource MaterialDesignDivider}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding Session.Metadata[INTRODUCCION], Mode=TwoWay}"
                                             Style="{StaticResource DocTagStyle}"
                                             HorizontalAlignment="Center"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             MinHeight="52"
                                             Margin="0,6,0,24"/>

                                    <!-- == SECCIÓN 2: OBJETIVOS ======================================== -->
                                    <StackPanel Margin="0,8,0,16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="2. " Style="{StaticResource SectionNumberStyle}"/>
                                            <TextBlock Text="OBJETIVOS" Style="{StaticResource SectionHeaderStyle}"/>
                                        </StackPanel>
                                        <Border Height="2" Background="{DynamicResource MaterialDesignDivider}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding Session.Metadata[OBJETIVOS], Mode=TwoWay}"
                                             Style="{StaticResource DocTagStyle}"
                                             HorizontalAlignment="Stretch"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             MinHeight="52"
                                             Margin="0,6,0,24"/>

                                    <!-- == SECCIÓN 3: ALCANCE ========================================== -->
                                    <StackPanel Margin="0,8,0,16">
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="3. " Style="{StaticResource SectionNumberStyle}"/>
                                            <TextBlock Text="ALCANCE" Style="{StaticResource SectionHeaderStyle}"/>
                                        </StackPanel>
                                        <Border Height="2" Background="{DynamicResource MaterialDesignDivider}" HorizontalAlignment="Stretch"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding Session.Metadata[ALCANCE], Mode=TwoWay}"
                                             Style="{StaticResource DocTagStyle}"
                                             HorizontalAlignment="Stretch"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Disabled"
                                             MinHeight="52"
                                             Margin="0,6,0,24"/>


                                    <!-- == SECCIÓN 4: DIAGRAMA DE PAQUETES / VISTA LÓGICA ============- -->
                                <StackPanel Margin="0,8,0,16">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="4. " Style="{StaticResource SectionNumberStyle}"/>
                                        <TextBlock Text="DIAGRAMA DE PAQUETES / VISTA LÓGICA" Style="{StaticResource SectionHeaderStyle}"/>
                                    </StackPanel>
                                    <Border Height="2" Background="{DynamicResource MaterialDesignDivider}" HorizontalAlignment="Stretch"/>
                                </StackPanel>
                                <TextBox Text="{Binding Session.Metadata[PQ_VISTA_LOGICA_DESC], Mode=TwoWay}"
                                         Style="{StaticResource DocTagStyle}"
                                         HorizontalAlignment="Stretch"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         MinHeight="52"
                                         Margin="0,6,0,16"
                                         FontStyle="Italic"/>

                                <!-- 4.1 Listado de paquetes -->
                                <TextBlock Text="4.1  Listado de paquetes" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" FontFamily="Cambria" Margin="0,0,0,8"/>
                                <Border Background="{DynamicResource StatusWarningMutedBackgroundBrush}" BorderBrush="{DynamicResource StatusWarningSoftBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="16,12" Margin="0,0,0,16">
                                    <StackPanel HorizontalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                                            <md:PackIcon Kind="TableLarge" Foreground="{DynamicResource PrimaryHueMidBrush}" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Session.Metadata[TABLA_RESUMEN_PQ], Mode=TwoWay}"
                                                     Style="{StaticResource DocTagStyle}" HorizontalAlignment="Left"/>
                                        </StackPanel>
                                        <TextBlock Text="Genera tabla: N, PAQUETES" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- 4.2 Presentación -->
                                <TextBlock Text="4.2  Presentación" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource MaterialDesignBody}" FontFamily="Cambria" Margin="0,0,0,8"/>
                                <Border BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" Background="{DynamicResource MaterialDesignPaper}" MinHeight="180" Margin="0,0,0,16">
                                    <StackPanel HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="24">
                                        <Border HorizontalAlignment="Center" Margin="0,0,0,8" Background="{DynamicResource MaterialDesignPaper}" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="16" Padding="3">
                                            <StackPanel Orientation="Horizontal">
                                                <ToggleButton Content="Código"
                                                              Tag="code"
                                                              IsChecked="{Binding ShowKrokiCode, Mode=TwoWay}"
                                                              Style="{StaticResource KrokiModeButtonStyle}" Margin="0,0,4,0"/>
                                                <ToggleButton Content="Vista previa"
                                                              Tag="preview"
                                                              IsChecked="{Binding ShowKrokiCode, Mode=TwoWay, Converter={StaticResource InvBool}}"
                                                              Style="{StaticResource KrokiModeButtonStyle}"/>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,6">
                                            <md:PackIcon Kind="ImageOutline" Foreground="{DynamicResource PrimaryHueMidBrush}" Width="13" Height="13" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                            <TextBox Text="{Binding Session.Metadata[IMG_VISTA_LOGICA], Mode=TwoWay}"
                                                     Style="{StaticResource DiagramCodeTextStyle}" HorizontalAlignment="Left"
                                                     Visibility="{Binding ShowKrokiCode, Converter={StaticResource BoolToVis}}"/>
                                        </StackPanel>
                                        <Border Visibility="{Binding ShowKrokiCode, Converter={StaticResource InvBoolToVis}}"
                                                BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="1" CornerRadius="6" Padding="8" Background="{DynamicResource MaterialDesignPaper}" Margin="0,0,0,6">
                                            <conv:KrokiSvgBrowser DiagramCode="{Binding Session.Metadata[IMG_VISTA_LOGICA]}" Height="260" HorizontalAlignment="Stretch"/>
                                        </Border>
                                        <TextBlock Text="Diagrama de paquetes" FontSize="9" FontStyle="Italic" Foreground="{DynamicResource MaterialDesignBodyLight}" HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>

                                <!-- 4.3 Especificación de paquetes -->
